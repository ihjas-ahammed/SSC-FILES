from pathlib import Path
import re, subprocess, xml.etree.ElementTree as ET
spec=Path('SPEC.md').read_text()
expected=re.findall(r'"'^### ('"\\S+\\.svg)\\s+viewBox ([\\d ]+)"'$'"',spec,re.M)
assert len(expected)==12
assert set(p.name for p in Path('.').glob('*.svg'))==set(n for n,v in expected)
for name,viewbox in expected:
 root=ET.parse(name).getroot()
 assert root.get('viewBox')==viewbox
 assert root.get('width') is None and root.get('height') is None
 assert root.get('role')=='img' and root.get('aria-label')
 result=subprocess.run(['rsvg-convert','-o','/tmp/check-'+name[:-4]+'.png',name],capture_output=True,text=True)
 print(f'{name}, {viewbox}, '+('OK' if result.returncode==0 else 'ERROR'))
 if result.stderr: print(result.stderr)
