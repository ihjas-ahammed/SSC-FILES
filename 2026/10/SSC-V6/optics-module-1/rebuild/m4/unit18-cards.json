    {
      "type": "info",
      "label": "02 · §20.6.2 Key fact",
      "title": "How more plates give a purer transmitted beam",
      "points": [
        "A single plate transmits only partially polarised light.",
        "Reflections from successive surfaces filter out the s-component.",
        "Each further surface removes more s-component from the transmitted ray.",
        "With about 15 plates, the transmitted ray is p-component alone."
      ]
    },
    {
      "type": "intuition",
      "term": "optics-m4-polarization-by-scattering",
      "title": "Particles scatter light sideways and polarise it",
      "meaning": "Polarization by scattering is partial polarisation of light scattered by tiny particles in a medium.",
      "points": [
        "Natural light makes the electrons in the particles vibrate.",
        "A vibrating electron emits no light along its own vibration.",
        "Light seen at about 90° is therefore strongly polarised."
      ]
    },
    {
      "type": "info",
      "label": "03 · §20.6.3 Definition",
      "title": "What is polarization by scattering?",
      "defines": [
        "optics-m4-polarization-by-scattering"
      ],
      "body": "Polarization by scattering is the partial polarisation of natural light scattered by ultramicroscopic particles suspended in a transparent medium.",
      "points": [
        "Starts with a narrow beam of natural light.",
        "The medium is transparent and holds ultramicroscopic particles in suspension.",
        "The scattered light is partially polarised."
      ],
