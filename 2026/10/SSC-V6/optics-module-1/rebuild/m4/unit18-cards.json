    {
      "type": "info",
      "label": "04 · §20.6.3 Key fact",
      "title": "Why light scattered at 90° is strongly polarised",
      "points": [
        "A vibrating electron emits most light perpendicular to its vibration, none along it.",
        "The emitted electric field is parallel to that vibration.",
        "So light scattered through about 90° is strongly polarised.",
        "Its E-vector is perpendicular to the plane of propagation and observation."
      ]
    },
    {
      "type": "intuition",
      "term": "optics-m4-multiple-scattering",
      "title": "Light can be scattered more than once",
      "meaning": "Multiple scattering is light that has been scattered more than once before it is seen.",
      "points": [
        "Sunlight in the sky can be scattered several times on its way down.",
        "Such light is less polarised than light scattered only once."
      ]
    },
    {
      "type": "info",
      "label": "05 · §20.6.3 Definition",
      "title": "What is multiple scattering?",
      "defines": [
        "optics-m4-multiple-scattering"
      ],
      "body": "Multiple scattering is light that has been scattered more than once before it reaches the observer.",
      "points": [
        "It lowers the degree of polarisation of scattered light.",
        "Much of the sunlight in the blue sky has undergone it."
      ],
