    {
      "type": "info",
      "label": "06 · §20.6.3 Key fact",
      "title": "Why blue sky light is not fully polarised",
      "points": [
        "Blue sky light is quite strongly polarised, most at 90° from the sun.",
        "A significant part of the sunlight has been scattered more than once.",
        "So sky light is not completely polarised."
      ]
    },
    {
      "type": "mcq",
      "label": "Quiz · OMR",
      "time": 60,
      "q": "After many plates, which component is left in the transmitted ray?",
      "options": [
        "s-component only",
        "p-component only",
        "Equal s and p components",
        "Unpolarised light"
      ],
      "answer": 1,
      "why": "Reflections at successive surfaces filter out the s-component, leaving p-component alone."
    },
    {
      "type": "mcq",
      "label": "Quiz · OMR",
      "time": 60,
      "q": "Which way does the E-vector point in light scattered at 90°?",
      "options": [
        "Parallel to the incident beam",
        "Along the direction of observation",
        "Perpendicular to the propagation-observation plane",
        "Random in every direction"
      ],
      "answer": 2,
      "why": "The E-vector of the scattered light is perpendicular to the plane of propagation and observation."
    },
