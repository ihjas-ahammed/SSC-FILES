{
  "cards": [
    {
      "type": "intuition",
      "term": "optics-m4-pile-of-plates",
      "title": "Many thin glass plates act as a polariser",
      "meaning": "A pile of plates is a stack of glass plates that transmits light polarised in one plane.",
      "points": [
        "Unpolarised light meets the plates at Brewster angle.",
        "Each surface reflects away some of the s-component.",
        "About 15 plates leave only the p-component in the transmitted ray."
      ]
    },
    {
      "type": "info",
      "label": "01 · §20.6.2 Definition",
      "title": "What is a pile of plates?",
      "defines": [
        "optics-m4-pile-of-plates"
      ],
      "body": "A pile of plates is a stack of glass plates, inclined at about 33° to the tube axis, that transmits light polarised parallel to the plane of incidence.",
      "points": [
        "The plates are supported in a tube of suitable size.",
        "Unpolarised light enters the tube and meets the plates at Brewster angle.",
        "About 15 glass plates are needed.",
        "The transmitted light is totally polarised parallel to the plane of incidence."
      ],
