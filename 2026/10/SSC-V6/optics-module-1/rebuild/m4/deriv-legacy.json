            ]
          }
        ],
        "showAllLabels": true
      },
      "phases": [
        {
          "name": "Resolve field",
          "why": "resolve incident amplitude E₀ along and perpendicular to P₂'s pass axis"
        },
        {
          "name": "Square amplitude",
          "why": "square the transmitted electric field component E_∥"
        },
        {
          "name": "Intensity ratio",
          "why": "multiply by proportionality constant K so I = K E_∥²"
        },
        {
          "name": "Malus's law",
          "why": "substitute I₀ = K E₀² to obtain I = I₀ cos²θ"
        }
      ],
      "steps": [
        {
          "phase": "Resolve field",
          "focus": [
            "E0",
            "Epar",
            "theta"
          ],
          "tex": "E_\\parallel = E_0\\cos\\theta",
          "note": "Resolve the incident electric field \\(E_0\\) along the pass axis of analyser \\(P_2\\) at angle \\(\\theta\\)."
        },
        {
          "focus": [
            "E0",
            "Eperp",
            "theta"
          ],
          "move": {
            "type": "rearrange",
            "label": "Write perpendicular component absorbed by analyser P₂"
          },
          "tex": "E_\\perp = E_0\\sin\\theta",
          "note": "The perpendicular component \\(E_0\\sin\\theta\\) is absorbed by \\(P_2\\), so only \\(E_\\parallel\\) emerges.",
          "ask": {
            "q": "Which component of \\(E_0\\) is transmitted by the analyser \\(P_2\\)?",
            "options": [
              "\\(E_\\parallel = E_0\\cos\\theta\\)",
              "\\(E_\\perp = E_0\\sin\\theta\\)",
              "\\(E_0\\tan\\theta\\)",
              "\\(E_0 / \\cos\\theta\\)"
            ],
            "answer": 0,
            "why": "The analyser transmits only the component \\(E_0\\cos\\theta\\) parallel to its pass axis (§22.2)."
          }
        },
        {
          "phase": "Square amplitude",
          "focus": [
            "Epar",
            "E0",
            "theta"
          ],
          "move": {
            "type": "power",
            "by": "2",
            "label": "Square both sides of E_∥ = E₀ cos θ"
          },
          "tex": "E_\\parallel^2 = E_0^2\\cos^2\\theta",
          "note": "Square the emergent amplitude \\(E_\\parallel\\) since intensity is proportional to amplitude squared.",
          "ask": {
            "q": "How is wave intensity \\(I\\) related to the emergent amplitude \\(E_\\parallel\\)?",
            "options": [
              "\\(I \\propto E_\\parallel\\)",
              "\\(I \\propto E_\\parallel^2\\)",
              "\\(I \\propto 1 / E_\\parallel\\)",
              "\\(I \\propto \\sqrt{E_\\parallel}\\)"
            ],
            "answer": 1,
            "why": "The intensity of an electromagnetic wave is proportional to the square of its electric field amplitude."
          }
        },
        {
          "phase": "Intensity ratio",
          "focus": [
            "Epar",
            "I"
          ],
          "move": {
            "type": "multiply",
            "by": "K"
          },
          "tex": "K E_\\parallel^2 = K E_0^2\\cos^2\\theta",
          "note": "Multiply both sides by the intensity proportionality constant \\(K\\)."
        },
        {
          "focus": [
            "Epar",
            "I"
          ],
          "move": {
            "type": "substitute",
            "by": "I = K E_\\parallel^2"
          },
          "tex": "I = K E_0^2\\cos^2\\theta",
          "note": "Replace \\(K E_\\parallel^2\\) on the left with emergent intensity \\(I\\).",
          "ask": {
            "q": "What does \\(K E_0^2\\) represent when the two Polaroids are parallel (\\(\\theta = 0\\))?",
            "options": [
              "Zero intensity",
              "Wavelength \\(\\lambda\\)",
              "Maximum intensity \\(I_0\\)",
              "Refractive index \\(n\\)"
            ],
            "answer": 2,
            "why": "When \\(\\theta = 0\\), \\(\\cos\\theta = 1\\) and the emergent intensity is \\(I_0 = K E_0^2\\) (§22.2)."
          }
        },
        {
          "phase": "Malus's law",
          "focus": [
            "E0",
            "Epar",
            "theta",
            "I"
          ],
          "move": {
            "type": "substitute",
            "by": "I_0 = K E_0^2"
          },
          "tex": "I = I_0\\cos^2\\theta",
          "note": "Substitute \\(I_0 = K E_0^2\\) to obtain Malus's law (Eq. 22.9).",
          "ask": {
            "q": "According to Malus's law, what is \\(I\\) when \\(\\theta = 90^\\circ\\)?",
            "options": [
              "\\(I_0\\)",
              "\\(I_0 / 2\\)",
              "\\(I_0 / 4\\)",
              "\\(0\\)"
            ],
            "answer": 3,
            "why": "Since \\(\\cos 90^\\circ = 0\\), \\(I = I_0\\cos^2 90^\\circ = 0\\) (complete extinction)."
          }
        }
      ],
      "unit": 19
    },
    {
      "type": "derivation",
      "label": "03 · §22.5 Derivation",
      "title": "Extraordinary ray velocity surface and refractive index",
      "legend": "This calculation describes the ray velocity surface used in Huygens' construction, not the phase-index surface. The optic axis is z. θ is the angle of the extraordinary energy ray to z, and ρ = v_re is its speed. The velocity ellipsoid has semiaxes a = c/n_o along z and b = c/n_e along x. Its section has coordinates z = ρ cos θ and x = ρ sin θ. Define ray index n_re = c/v_re. The starting velocity law is the textbook's material relation; the steps show why it gives an ellipsoid and how to obtain n_re.",
      "setup": {
        "view": {
          "bbox": [
            0,
            180,
            260,
            0
          ],
          "axis": false,
          "grid": false
        },
        "steps": [
          {
            "step": 0,
            "name": "Velocity law",
            "objects": [
              {
                "type": "arrow",
                "p1": [
                  40,
                  90
                ],
                "p2": [
                  224,
                  90
                ],
                "role": "gk",
                "width": 1.6,
                "name": "zaxis"
              },
              {
                "type": "arrow",
                "p1": [
                  130,
                  18
                ],
                "p2": [
                  130,
                  164
                ],
                "role": "gk",
                "width": 1.6,
                "name": "xaxis"
              },
              {
                "type": "ellipse",
                "center": [
                  130,
                  90
                ],
                "rx": 42,
                "ry": 58,
                "role": "lk",
                "name": "ellipsoid"
              },
              {
                "type": "circle",
                "center": [
                  130,
                  90
                ],
                "r": 42,
                "role": "ik",
                "name": "sphere"
              },
              {
                "type": "arrow",
                "p1": [
                  130,
                  90
                ],
                "p2": [
                  158,
                  133
                ],
                "role": "lk",
                "width": 2.4,
                "name": "vre"
              },
              {
                "type": "arc",
                "center": [
                  130,
                  90
                ],
                "r": 24,
                "start": 0,
                "end": 57,
                "role": "lk",
                "width": 1.8,
                "name": "theta"
              },
              {
                "type": "label",
                "coords": [
                  206,
                  76
                ],
                "text": "z (Optic axis)",
                "size": 10,
                "align": "center",
                "role": "t",
                "name": "zaxis"
              },
              {
                "type": "label",
                "coords": [
                  140,
                  158
                ],
                "text": "x",
                "size": 11,
                "role": "t",
                "name": "xaxis"
              },
              {
                "type": "label",
                "coords": [
                  162,
                  104
                ],
                "text": "θ",
                "size": 11,
                "role": "t",
                "name": "theta"
              },
              {
                "type": "label",
                "coords": [
                  178,
                  138
                ],
                "text": "v_re (ρ)",
                "size": 10,
                "role": "t",
                "name": "vre"
              }
            ]
          },
          {
            "step": 4,
            "name": "Ray index",
            "objects": [
              {
                "type": "label",
                "coords": [
                  66,
                  148
                ],
                "text": "n_re = c / v_re",
                "size": 11,
                "align": "center",
                "role": "t",
                "name": "nre"
              }
            ]
          }
        ],
        "showAllLabels": true
      },
      "phases": [
        {
          "name": "Velocity law",
          "why": "start from the extraordinary ray velocity equation at angle θ"
        },
        {
          "name": "Polar ellipse",
          "why": "set a = c/n_o, b = c/n_e, ρ = v_{re} and convert to Cartesian (z, x)"
        },
        {
          "name": "Ray index",
          "why": "multiply Eq. (22.37) by c² and substitute n_{re} = c / v_{re}"
        },
        {
          "name": "Result",
          "why": "take the square root to obtain the extraordinary ray refractive index"
        }
      ],
      "steps": [
        {
          "phase": "Velocity law",
          "focus": [
            "ellipsoid",
            "vre",
            "theta"
          ],
          "tex": "\\frac{1}{v_{re}^2} = \\frac{\\sin^2\\theta}{(c / n_e)^2} + \\frac{\\cos^2\\theta}{(c / n_o)^2}",
          "note": "Start from the extraordinary ray velocity equation at angle \\(\\theta\\) to the optic axis (Eq. 22.37)."
        },
        {
          "phase": "Polar ellipse",
          "focus": [
            "ellipsoid",
            "vre",
            "theta"
          ],
          "move": {
            "type": "substitute",
            "by": "a = \\frac{c}{n_o},\\,b = \\frac{c}{n_e},\\,\\rho = v_{re}"
          },
          "tex": "\\frac{1}{\\rho^2} = \\frac{\\cos^2\\theta}{a^2} + \\frac{\\sin^2\\theta}{b^2}",
          "note": "Set semi-axes \\(a = c/n_o\\), \\(b = c/n_e\\), and polar radius \\(\\rho = v_{re}\\) (Eq. 22.39).",
          "ask": {
            "q": "Along the optic axis (\\(\\theta = 0\\)), what does \\(v_{re}\\) equal?",
            "options": [
              "\\(c / n_o = v_{ro}\\)",
              "\\(c / n_e\\)",
              "\\(0\\)",
              "\\(c\\)"
            ],
            "answer": 0,
            "why": "At \\(\\theta = 0\\), \\(\\sin\\theta = 0\\) and \\(\\cos\\theta = 1\\), so \\(v_{re} = c/n_o = v_{ro}\\) (§22.5)."
          }
        },
        {
          "focus": [
            "ellipsoid",
            "vre"
          ],
          "move": {
            "type": "multiply",
            "by": "\\rho^2"
          },
          "tex": "1 = \\frac{\\rho^2\\cos^2\\theta}{a^2} + \\frac{\\rho^2\\sin^2\\theta}{b^2}",
          "note": "Multiply both sides by \\(\\rho^2\\).",
          "ask": {
            "q": "In polar coordinates \\((\\rho, \\theta)\\) around the \\(z\\)-axis, what are \\(z\\) and \\(x\\)?",
            "options": [
              "\\(z = \\rho,\\,x = \\theta\\)",
              "\\(z = \\rho\\cos\\theta,\\,x = \\rho\\sin\\theta\\)",
              "\\(z = \\rho\\sin\\theta,\\,x = \\rho\\cos\\theta\\)",
              "\\(z = a,\\,x = b\\)"
            ],
            "answer": 1,
            "why": "With \\(\\theta\\) measured from the \\(z\\)-axis, \\(z = \\rho\\cos\\theta\\) and \\(x = \\rho\\sin\\theta\\) (§22.5)."
          }
        },
        {
          "focus": [
            "ellipsoid",
            "zaxis",
            "xaxis"
          ],
          "move": {
            "type": "substitute",
            "by": "z = \\rho\\cos\\theta,\\,x = \\rho\\sin\\theta"
          },
          "tex": "1 = \\frac{z^2}{a^2} + \\frac{x^2}{b^2}",
          "note": "Thus plotting \\(v_{re}(\\theta)\\) in 3D gives an ellipsoid of revolution (Eq. 22.38)."
        },
        {
          "phase": "Ray index",
          "focus": [
            "vre",
            "nre",
            "theta"
          ],
          "move": {
            "type": "rearrange",
            "label": "Multiply Eq. (22.37) by c²"
          },
          "tex": "\\frac{c^2}{v_{re}^2} = n_o^2\\cos^2\\theta + n_e^2\\sin^2\\theta",
          "note": "Multiply both sides of Eq. (22.37) by \\(c^2\\) to express \\((c/v_{re})^2\\).",
          "ask": {
            "q": "How is the extraordinary ray refractive index \\(n_{re}\\) defined?",
            "options": [
              "\\(n_{re} = v_{re} / c\\)",
              "\\(n_{re} = n_o + n_e\\)",
              "\\(n_{re} = c / v_{re}\\)",
              "\\(n_{re} = n_o / n_e\\)"
            ],
            "answer": 2,
            "why": "By definition (Eq. 22.45), the ray refractive index is \\(n_{re} = c / v_{re}\\)."
          }
        },
        {
          "focus": [
            "nre",
            "theta"
          ],
          "move": {
            "type": "substitute",
            "by": "n_{re} = \\frac{c}{v_{re}}"
          },
          "tex": "n_{re}^2 = n_o^2\\cos^2\\theta + n_e^2\\sin^2\\theta",
          "note": "Substitute \\(n_{re} = c / v_{re}\\) on the left-hand side.",
          "ask": {
            "q": "Perpendicular to the optic axis (\\(\\theta = \\pi/2\\)), what does \\(n_{re}\\) equal?",
            "options": [
              "\\(n_o\\)",
              "\\(\\sqrt{n_o^2 + n_e^2}\\)",
              "\\(0\\)",
              "\\(n_e\\)"
            ],
            "answer": 3,
            "why": "At \\(\\theta = \\pi/2\\), \\(\\cos\\theta = 0\\) and \\(\\sin\\theta = 1\\), so \\(n_{re} = n_e\\)."
          }
        },
        {
          "phase": "Result",
          "focus": [
            "ellipsoid",
            "nre",
            "theta"
          ],
          "move": {
            "type": "root"
          },
          "tex": "n_{re} = \\sqrt{n_o^2\\cos^2\\theta + n_e^2\\sin^2\\theta}",
          "note": "Take the positive square root to get the extraordinary ray refractive index (Eq. 22.45)."
        }
      ],
      "unit": 20
    },
    {
      "type": "derivation",
      "label": "03 · §22.8 Derivation",
      "title": "Rotation of plane of polarisation in an optically active medium",
      "legend": "A linearly polarised wave entering along +z can be written as equal RCP and LCP waves, each with component amplitude E₀. Use the displayed component equations to define the handedness convention. Their wavenumbers are k_R = 2πn_R/λ and k_L = 2πn_L/λ, with vacuum wavelength λ. Define θ(z) = (k_L+k_R)z/2 for their common phase and φ(z) for the rotation of the resulting line. Assume no differential absorption, so the two circular amplitudes remain equal.",
      "setup": {
        "view": {
          "bbox": [
            0,
            180,
            260,
            0
          ],
          "axis": false,
          "grid": false
        },
        "steps": [
          {
            "step": 0,
            "name": "Superpose x",
            "objects": [
              {
                "type": "arrow",
                "p1": [
                  40,
                  88
                ],
                "p2": [
                  224,
                  88
                ],
                "role": "gk",
                "width": 1.6,
                "name": "Ey"
              },
              {
                "type": "arrow",
                "p1": [
                  130,
                  18
                ],
                "p2": [
                  130,
                  164
                ],
                "role": "gk",
                "width": 1.6,
                "name": "Ex"
              },
              {
                "type": "segment",
                "p1": [
                  130,
                  88
                ],
                "p2": [
                  130,
                  144
                ],
                "role": "lk",
                "width": 2.4,
                "name": "Ex"
              },
              {
                "type": "label",
                "coords": [
                  116,
                  154
                ],
                "text": "x (E_x)",
                "size": 10,
                "align": "right",
                "role": "t",
                "name": "Ex"
              },
              {
                "type": "label",
                "coords": [
                  216,
                  76
                ],
                "text": "y (E_y)",
                "size": 10,
                "role": "t",
                "name": "Ey"
              }
            ]
          },
          {
            "step": 2,
            "name": "Superpose y",
            "objects": [
              {
                "type": "segment",
                "p1": [
                  130,
                  144
                ],
                "p2": [
                  164,
                  144
                ],
                "role": "ik",
                "width": 2.2,
                "name": "Ey"
              },
              {
                "type": "point",
                "coords": [
                  164,
                  144
                ],
                "id": "P",
                "role": "f",
                "name": "Ey"
              }
            ]
          },
          {
            "step": 4,
            "name": "Rotation angle",
            "objects": [
              {
                "type": "arrow",
                "p1": [
                  130,
                  88
                ],
                "p2": [
                  164,
                  144
                ],
                "role": "lk",
                "width": 2.6,
                "name": "phi"
              },
              {
                "type": "arc",
                "center": [
                  130,
                  88
                ],
                "r": 36,
                "start": 59,
                "end": 90,
                "role": "lk",
                "width": 1.8,
                "name": "phi"
              },
              {
                "type": "label",
                "coords": [
                  144,
                  132
                ],
                "text": "φ(z)",
                "size": 11,
                "role": "t",
                "name": "phi"
              },
              {
                "type": "label",
                "coords": [
                  130,
                  18
                ],
                "text": "n_L ≠ n_R",
                "size": 11,
                "align": "center",
                "role": "t",
                "name": "nLnR"
              }
            ]
          }
        ],
        "showAllLabels": true
      },
      "phases": [
        {
          "name": "Superpose x",
          "why": "add the x-components of the RCP and LCP waves"
        },
        {
          "name": "Superpose y",
          "why": "add the y-components of the RCP and LCP waves"
        },
        {
          "name": "Rotation angle",
          "why": "divide E_y by E_x to find the rotation angle φ(z)"
        },
        {
          "name": "Refractive indices",
          "why": "substitute k_L = 2πn_L/λ and k_R = 2πn_R/λ"
        }
      ],
      "steps": [
        {
          "phase": "Superpose x",
          "focus": [
            "Ex"
          ],
          "tex": "E_x = E_0[\\cos(k_R z - \\omega t) + \\cos(k_L z - \\omega t)]",
          "note": "Add the \\(x\\)-components of the RCP wave (Eq. 22.56) and LCP wave (Eq. 22.57)."
        },
        {
          "focus": [
            "Ex"
          ],
          "move": {
            "type": "identity",
            "by": "\\cos A + \\cos B = 2\\cos\\tfrac{B-A}{2}\\cos\\tfrac{A+B}{2}"
          },
          "tex": "E_x = 2E_0\\cos\\left[\\frac{1}{2}(k_L - k_R)z\\right]\\cos[\\omega t - \\theta(z)]",
          "note": "Combine the two cosines, where \\(\\theta(z) = \\frac{1}{2}(k_L + k_R)z\\).",
          "ask": {
            "q": "At \\(z = 0\\), what are \\(E_x\\) and \\(E_y\\) when the RCP and LCP waves add?",
            "options": [
              "\\(E_x = 2E_0\\cos\\omega t,\\,E_y = 0\\)",
              "\\(E_x = 0,\\,E_y = 2E_0\\cos\\omega t\\)",
              "\\(E_x = E_y = E_0\\)",
              "\\(E_x = 0,\\,E_y = 0\\)"
            ],
            "answer": 0,
            "why": "At \\(z = 0\\), the \\(y\\)-components \\(-\\sin(-\\omega t)\\) and \\(+\\sin(-\\omega t)\\) cancel, leaving linear polarisation along \\(x\\)."
          }
        },
        {
          "phase": "Superpose y",
