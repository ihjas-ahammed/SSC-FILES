{
  "cards": [
    {
      "type": "intuition",
      "term": "optics-m4-retarder",
      "title": "A plate that delays one wave against the other",
      "meaning": "A retarder splits light into two waves and makes one of them lag behind the other.",
      "points": [
        "<b>Inside</b>: the incident wave splits into o- and e-waves.",
        "<b>Speeds</b>: the two waves travel at different speeds through the plate.",
        "<b>Result</b>: they leave with a phase retardation set by the thickness d.",
        "<b>Uses</b>: make circular or elliptical light; analyse light into elliptical components."
      ]
    },
    {
      "type": "info",
      "label": "01 · §20.19 Definition",
      "title": "What is a retarder?",
      "defines": [
        "optics-m4-retarder"
      ],
      "body": "A retarder is a uniform plate of birefringent material whose optic axis lies in the plane of the plate.",
      "points": [
        "<b>Splits</b> the incident wave into two polarized waves.",
        "The two waves travel perpendicular to the plate at different speeds.",
        "<b>Phase retardation</b> builds up across the thickness d.",
        "Named by action: quarter-wave, half-wave or full-wave plate."
      ],
