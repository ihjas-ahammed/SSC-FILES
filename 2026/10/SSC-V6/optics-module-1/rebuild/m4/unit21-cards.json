    {
      "type": "info",
      "label": "05 · §20.18 Special cases",
      "title": "Special cases of the superposition",
      "points": [
        "<b>\\(\\delta = 0\\)</b> (or \\(\\pm 2m\\pi\\)): in phase, a straight line, so plane polarized.",
        "<b>\\(\\delta = \\pi\\)</b> (or odd multiples): opposite phase, a straight line, so plane polarized.",
        "<b>\\(\\delta = \\pi/2\\)</b> (or odd multiples): ellipse on the y and z axes; circular if \\(E_1 = E_2\\).",
        "<b>Other \\(\\delta\\)</b>: general ellipse (Eq. 20.43), so elliptically polarized."
      ]
    },
    {
      "type": "math",
      "label": "Formula",
      "title": "Quarter wave plate thickness",
      "tex": "d = \\frac{\\lambda}{4(\\mu_o-\\mu_e)}",
      "points": [
        "From \\((\\mu_o-\\mu_e)\\,d = \\lambda/4\\) (Eq. 20.48), giving Eq. 20.49.",
        "<b>Thickness</b> depends on \\(\\lambda\\) and the birefringence \\(\\mu_o-\\mu_e\\)."
      ]
    },
    {
      "type": "math",
      "label": "Formula",
      "title": "Half wave plate thickness",
      "tex": "d = \\frac{\\lambda}{2(\\mu_o-\\mu_e)}",
      "points": [
        "From \\((\\mu_o-\\mu_e)\\,d = \\lambda/2\\) (Eq. 20.50), giving Eq. 20.51.",
        "For the same birefringence, it is twice the quarter wave plate thickness."
      ]
    },
    {
      "type": "mcq",
      "label": "Quiz · OMR",
      "time": 60,
      "q": "A half wave plate rotates a linear wave's plane by what angle?",
      "options": [
        "\\(\\theta\\)",
        "\\(2\\theta\\)",
        "\\(\\theta/2\\)",
        "\\(90^\\circ\\)"
      ],
      "answer": 1,
      "why": "It rotates the plane through \\(2\\theta\\), where \\(\\theta\\) is the angle of E to the optic axis."
    },
    {
      "type": "mcq",
      "label": "Quiz · OMR",
      "time": 60,
      "q": "Two waves polarized at right angles, in phase, give which state?",
      "options": [
        "Circularly polarized",
        "Unpolarized light",
        "Plane polarized",
        "Elliptically polarized"
      ],
      "answer": 2,
      "why": "In-phase perpendicular waves add to a straight line, which is plane polarized."
    },
    {
      "type": "fill",
      "label": "Quiz · Fill in",
      "time": 60,
      "q": "A ______ wave plate gives a \\(\\lambda/2\\) path difference.",
      "answer": "half|half-wave|half wave",
      "why": "A half wave plate gives \\(\\lambda/2\\), i.e. a \\(180^\\circ\\) phase difference."
    },
    {
      "type": "number",
      "label": "Quiz · Number",
      "time": 60,
      "q": "A quarter wave plate gives what phase difference, in degrees?",
      "answer": 90,
      "tolerance": 0,
      "unit": "°",
      "why": "A quarter wave plate gives \\(\\delta = \\pi/2 = 90^\\circ\\)."
    }
  ],
