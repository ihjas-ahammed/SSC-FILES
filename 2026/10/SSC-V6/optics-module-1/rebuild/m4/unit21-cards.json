    {
      "type": "intuition",
      "term": "optics-m4-half-wave-plate",
      "title": "A plate that makes a half-wave delay",
      "meaning": "A half wave plate delays one wave by half a wavelength relative to the other.",
      "points": [
        "<b>Delay</b>: \\(\\lambda/2\\) between the e-ray and o-ray.",
        "<b>Phase</b>: that delay is a \\(180^\\circ\\) phase difference.",
        "<b>Use</b>: turns the plane of a linear wave through \\(2\\theta\\).",
        "<b>Handedness</b>: flips circular or elliptical light."
      ]
    },
    {
      "type": "info",
      "label": "03 · §20.19.2 Definition",
      "title": "What is a half wave plate?",
      "defines": [
        "optics-m4-half-wave-plate"
      ],
      "body": "A half wave plate is a thin birefringent plate, optic axis parallel to its faces, that gives a \\(\\lambda/2\\) path difference between e- and o-rays.",
      "points": [
        "<b>Thickness</b> is set so the path difference is \\(\\lambda/2\\).",
        "Phase difference: \\(\\delta = \\pi = 180^\\circ\\).",
        "<b>Rotation</b>: a linear wave's plane turns through \\(2\\theta\\).",
        "\\(\\theta\\) is the angle between E and the optic axis.",
        "<b>Handedness</b>: right and left circular or elliptical light swap."
      ],
      "tex": "(\\mu_o-\\mu_e)\\,d = \\frac{\\lambda}{2}",
