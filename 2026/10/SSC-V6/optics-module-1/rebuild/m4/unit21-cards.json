    {
      "type": "intuition",
      "term": "optics-m4-quarter-wave-plate",
      "title": "A plate that makes a quarter-wave delay",
      "meaning": "A quarter wave plate delays one wave by a quarter wavelength relative to the other.",
      "points": [
        "<b>Delay</b>: \\(\\lambda/4\\) between the e-ray and o-ray.",
        "<b>Phase</b>: that delay is a \\(90^\\circ\\) phase difference.",
        "<b>Use</b>: plane polarized light in, elliptical or circular light out."
      ]
    },
    {
      "type": "info",
      "label": "02 · §20.19.1 Definition",
      "title": "What is a quarter wave plate?",
      "defines": [
        "optics-m4-quarter-wave-plate"
      ],
      "body": "A quarter wave plate is a thin birefringent plate, optic axis parallel to its faces, that gives a \\(\\lambda/4\\) path difference between e- and o-rays.",
      "points": [
        "<b>Thickness</b> is set so the path difference is \\(\\lambda/4\\).",
        "Phase difference: \\(\\delta = \\pi/2 = 90^\\circ\\).",
        "<b>Use</b>: makes elliptically or circularly polarized light.",
        "Output depends on the angle the incident E vector makes with the optic axis."
      ],
      "tex": "(\\mu_o-\\mu_e)\\,d = \\frac{\\lambda}{4}",
