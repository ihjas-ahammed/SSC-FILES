          "cards": [
            {"type": "question", "label": "PYQ · 5 marks", "title": "Question 17", "marks": 5, "q": "Determine the radius of the first zone in a zone plate of focal length 20 cm for light of wavelength 500 nm."},
            {"type": "eval", "q": "Formula r1 = sqrt(f lambda) and numerical calculation", "options": [{"t": "Formula r1 = sqrt(f lambda) and r1 = 0.0316 cm (0.316 mm) with units", "m": 5}, {"t": "Correct formula with unit conversion error", "m": 3}, {"t": "Formula only", "m": 1.5}, {"t": "Missing or wrong", "m": 0}], "why": "Use r1 = sqrt(f lambda) with f = 0.20 m and lambda = 500 x 10^-9 m."},
            {"type": "score", "title": "Q17 · Your marks"},
            {"type": "info", "label": "Answer", "title": "First zone radius r1 = 0.316 mm (0.0316 cm)", "body": "Know first: Fresnel diffraction and zone plate. The principal focal length of a zone plate is \\( f = r_1^2 / \\lambda \\), so the radius of the first zone is \\( r_1 = \\sqrt{f\\lambda} \\). Substituting \\( f = 20\\text{ cm} = 0.20\\text{ m} \\) and \\( \\lambda = 500\\text{ nm} = 5\\times 10^{-7}\\text{ m} \\) gives \\( r_1 = \\sqrt{10^{-7}\\text{ m}^2} = 3.162\\times 10^{-4}\\text{ m} = 0.316\\text{ mm} \\).", "tex": "r_1 = 3.162 \\times 10^{-4}\\text{ m} = 0.0316\\text{ cm}"},
            {"type": "math", "label": "Solution", "title": "Calculation of first half-period zone radius", "tex": "f = 20\\text{ cm} = 0.20\\text{ m}, \\quad \\lambda = 500\\text{ nm} = 5 \\times 10^{-7}\\text{ m} \\\\ f = \\frac{r_1^2}{\\lambda} \\implies r_1 = \\sqrt{f\\lambda} \\\\ r_1 = \\sqrt{0.20 \\times 5 \\times 10^{-7}} = \\sqrt{10^{-7}} = 3.162 \\times 10^{-4}\\text{ m} = 0.0316\\text{ cm} = 0.316\\text{ mm}", "body": "Convert focal length and wavelength to meters and take the square root of their product. Formula 1.5 · substitution 1.5 · answer with units 2."},
            {"type": "mcq", "q": "The radius \\( r_1 \\) of the first half-period zone of a zone plate of focal length \\( f \\) is ____.", "options": ["square root of (f lambda)", "f times lambda", "f divided by lambda", "f squared lambda"], "answer": 0, "time": 45, "practice": "remember-word", "why": "From f = r1^2 / lambda, we get r1 = sqrt(f lambda)."},
            {"type": "mcq", "q": "If the wavelength \\( \\lambda \\) is increased, the principal focal length \\( f = r_1^2 / \\lambda \\) of a given zone plate ____.", "options": ["decreases", "increases", "remains constant", "becomes infinite"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Focal length of a zone plate is inversely proportional to wavelength."},
            {"type": "mcq", "q": "The area of each Fresnel half-period zone on a plane wavefront is approximately ____.", "options": ["pi f lambda", "2 pi f^2", "lambda squared", "r1 cubed"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Area = pi(r_n^2 - r_{n-1}^2) = pi f lambda, independent of n."}
          ]
