          "cards": [
            {"type": "question", "label": "PYQ · 2 marks", "title": "Question 11", "marks": 2, "q": "What do you mean by a graded index fiber ? Draw its refractive index profile."},
            {"type": "eval", "q": "Definition of GRIN fiber and parabolic core index profile", "options": [{"t": "Continuous radial decrease of core refractive index defined and parabolic profile sketched", "m": 2}, {"t": "Only verbal definition or only sketch given", "m": 1}, {"t": "Missing or wrong", "m": 0}], "why": "Explain the radially decreasing core index and sketch n(r)."},
            {"type": "score", "title": "Q11 · Your marks"},
            {"type": "info", "label": "Answer", "title": "Graded-index (GRIN) optical fiber", "body": "Know first: Laws of reflection and refraction from Fermat's principle. A graded-index fiber is an optical fiber whose core refractive index is not constant, but decreases continuously (typically parabolically) from a maximum value \\( n_1 \\) at the central axis to the cladding value \\( n_2 \\) at the core-cladding boundary \\( r = a \\). Its profile shows a smooth parabolic peak in the core and a flat level \\( n_2 \\) in the cladding.", "tex": "n^2(r) = n_1^2\\left[1 - 2\\Delta\\left(\\frac{r}{a}\\right)^2\\right] \\quad (r \\le a)"},
            {"type": "math", "label": "Solution", "title": "Parabolic refractive index profile", "tex": "n(r) = \\begin{cases} n_1\\sqrt{1 - 2\\Delta(r/a)^2}, & r < a \\\\ n_2, & r \\ge a \\end{cases}", "body": "Define the continuous radial variation of n(r) in the core and sketch the parabolic curve for r < a with constant n2 for r >= a. Definition 1 · profile diagram 1."},
            {"type": "mcq", "q": "In a graded-index fiber, the refractive index is maximum at the ____.", "options": ["core axis", "cladding boundary", "outer jacket", "buffer coating"], "answer": 0, "time": 45, "practice": "remember-word", "why": "n(r) is highest on the axis (r = 0) and decreases radially outward."},
            {"type": "mcq", "q": "Ray paths in a parabolic-index graded-index fiber are ____.", "options": ["sinusoidal curves", "sharp zig-zag lines", "straight lines off-axis", "circles"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Continuous refraction bends rays smoothly in sinusoidal trajectories."},
            {"type": "mcq", "q": "Compared to a multimode step-index fiber, a graded-index fiber greatly reduces ____.", "options": ["intermodal pulse dispersion", "core diameter", "transmission speed", "optical frequency"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Outer rays travel faster in the lower-index region, equalizing transit times."}
          ]
        },
