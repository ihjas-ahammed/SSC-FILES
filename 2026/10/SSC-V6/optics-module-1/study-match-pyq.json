            {"type": "score", "title": "Q13 · Your marks"},
            {"type": "info", "label": "Answer", "title": "Division of wavefront vs division of amplitude", "body": "Know first: Interference: division of wavefront. In division of wavefront, a primary wavefront from a narrow slit or point source is spatially divided into two coherent beams by apertures, mirrors, or prisms (e.g., Young's double slit, Fresnel's biprism, Lloyd's mirror). In division of amplitude, the amplitude (intensity) of an incident beam (usually from an extended source) is divided into two coherent beams by partial reflection and transmission at a boundary (e.g., thin films, Newton's rings, Michelson interferometer).", "tex": "\\text{Wavefront: spatial split; Amplitude: partial reflection/transmission}"},
            {"type": "math", "label": "Solution", "title": "Comparison of the two interference classes", "tex": "\\text{1. Division of wavefront: } S \\to (S_1, S_2) \\text{ spatially (point/slit source)} \\\\ \\text{2. Division of amplitude: } E_{\\text{inc}} \\to E_{\\text{refl}} + E_{\\text{trans}} \\text{ at boundary (extended source)}", "body": "State the principle and an example for division of wavefront and division of amplitude. Division of wavefront 1 · division of amplitude 1."},
            {"type": "mcq", "q": "Fresnel's biprism and Fresnel's double mirror produce interference by division of ____.", "options": ["wavefront", "amplitude", "polarization", "frequency"], "answer": 0, "time": 45, "practice": "remember-word", "why": "They split two spatial halves of the cylindrical wavefront from a narrow slit."},
            {"type": "mcq", "q": "Newton's rings and the Michelson interferometer produce interference by division of ____.", "options": ["amplitude", "wavefront", "wavelength", "diffraction"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Each ray is split into reflected and transmitted amplitudes at a partially reflecting surface."},
            {"type": "mcq", "q": "A broad extended source can be used to produce bright fringes in interference by division of ____.", "options": ["amplitude", "wavefront", "slits", "pinholes"], "answer": 0, "time": 45, "practice": "remember-word", "why": "In amplitude division, each ray interferes only with its own reflected/transmitted partner."}
          ]
