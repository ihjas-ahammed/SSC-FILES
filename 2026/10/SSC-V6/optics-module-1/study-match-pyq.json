          "cards": [
            {"type": "question", "label": "PYQ · 4 marks", "title": "Question 26", "marks": 4, "q": "In an interference experiment, the slit source is at a distance of 2 mm from the plane of the mirror. If the wavelength of the light used is 589 nm and the screen is kept at a distance of 1.5 m from the source. Calculate the fringe width."},
            {"type": "eval", "q": "Virtual source separation d = 2h = 4 mm and fringe width beta", "options": [{"t": "Correct d = 2 x 2 mm = 4 mm and beta = 2.209 x 10^-4 m (0.221 mm)", "m": 4}, {"t": "Used d = 2 mm instead of 4 mm, giving 0.442 mm", "m": 2.5}, {"t": "Formula only", "m": 1}, {"t": "Missing or wrong", "m": 0}], "why": "In Lloyd's mirror, a slit at height h = 2 mm above the mirror plane forms a virtual image 2 mm below, so d = 2h = 4 mm."},
            {"type": "score", "title": "Q26 · Your marks"},
            {"type": "info", "label": "Answer", "title": "Fringe width beta = 0.221 mm", "body": "Know first: Interference with white light, Lloyd's mirror, phase change on reflection (9). When the slit source is at distance \\( h = 2\\text{ mm} \\) from the plane of Lloyd's mirror, its virtual image lies \\( 2\\text{ mm} \\) behind the mirror plane, so the separation between the coherent sources is \\( d = 2h = 4\\text{ mm} = 4\\times 10^{-3}\\text{ m} \\). With \\( D = 1.5\\text{ m} \\) and \\( \\lambda = 589\\text{ nm} \\), \\( \\beta = \\frac{\\lambda D}{d} = 2.209\\times 10^{-4}\\text{ m} = 0.221\\text{ mm} \\).", "tex": "\\beta = 2.209 \\times 10^{-4}\\text{ m} = 0.221\\text{ mm}"},
            {"type": "math", "label": "Solution", "title": "Lloyd's mirror fringe width calculation", "tex": "h = 2\\text{ mm} \\implies d = 2h = 4\\text{ mm} = 4 \\times 10^{-3}\\text{ m} \\\\ \\lambda = 589\\text{ nm} = 589 \\times 10^{-9}\\text{ m}, \\quad D = 1.5\\text{ m} \\\\ \\beta = \\frac{\\lambda D}{d} = \\frac{589 \\times 10^{-9} \\times 1.5}{4 \\times 10^{-3}} = 2.2088 \\times 10^{-4}\\text{ m} \\approx 0.221\\text{ mm}", "body": "Find source separation d = 2h from the mirror symmetry and substitute into beta = lambda D / d. Separation d = 2h 1.5 · formula 1 · result 1.5."},
            {"type": "mcq", "q": "If a slit is at height \\( h \\) above the plane of Lloyd's mirror, the distance \\( d \\) between the slit and its virtual image is ____.", "options": ["2h", "h", "h over 2", "4h"], "answer": 0, "time": 45, "practice": "remember-word", "why": "A plane mirror forms a virtual image at equal distance h behind the mirror surface."},
            {"type": "mcq", "q": "In Lloyd's mirror experiment, the central fringe at the point of contact with the mirror plane is ____.", "options": ["dark", "bright", "colored", "polarized"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Reflection at grazing incidence from a denser medium introduces a phase change of pi."},
