          "cards": [
            {"type": "question", "label": "PYQ · 5 marks", "title": "Question 16", "marks": 5, "q": "Consider a diffraction grating having 15000 lines per inch. Obtain the angular separation of the D_1 and D_2 lines of sodium in the second order spectra."},
            {"type": "eval", "q": "Grating element d, diffraction angles or d theta, and angular separation", "options": [{"t": "Correct d = 2.54/15000 cm and second-order angular separation d theta = 8.95 x 10^-4 rad (or 0.051 degrees / 3.1')", "m": 5}, {"t": "Correct formula and d with minor arithmetic error", "m": 3}, {"t": "Grating equation stated only", "m": 1.5}, {"t": "Missing or wrong", "m": 0}], "why": "Compute d from 15000 lines/inch and find the angular difference in second order (m=2) for 5890 A and 5896 A."},
            {"type": "score", "title": "Q16 · Your marks"},
            {"type": "info", "label": "Answer", "title": "Angular separation Delta theta = 0.051 degrees (3.08 arcmin)", "body": "Know first: N-slit Fraunhofer diffraction pattern and grating. For \\( 15000\\text{ lines/inch} \\), the grating spacing is \\( d = \\frac{2.54\\text{ cm}}{15000} = 1.693\\times 10^{-4}\\text{ cm} \\). Using \\( \\lambda_1 = 5890\\text{ \\AA} \\) and \\( \\lambda_2 = 5896\\text{ \\AA} \\) in second order (\\( m = 2 \\)), \\( \\sin\\theta_1 = \\frac{2\\lambda_1}{d} = 0.6957 \\) (\\( \\theta_1 = 44.081^\\circ \\)) and \\( \\sin\\theta_2 = \\frac{2\\lambda_2}{d} = 0.6964 \\) (\\( \\theta_2 = 44.132^\\circ \\)), giving \\( \\Delta\\theta = 0.051^\\circ \\approx 8.95\\times 10^{-4}\\text{ rad} \\).", "tex": "\\Delta\\theta = 8.95 \\times 10^{-4}\\text{ rad} = 0.051^\\circ = 3'5''"},
            {"type": "math", "label": "Solution", "title": "Second-order angular dispersion of sodium doublet", "tex": "d = \\frac{2.54\\text{ cm}}{15000} = 1.6933 \\times 10^{-4}\\text{ cm}, \\quad m = 2 \\\\ \\lambda_1 = 5.890 \\times 10^{-5}\\text{ cm}, \\quad \\lambda_2 = 5.896 \\times 10^{-5}\\text{ cm}, \\quad d\\lambda = 6 \\times 10^{-8}\\text{ cm} \\\\ \\sin\\theta = \\frac{m\\lambda}{d} \\approx 0.6957 \\implies \\cos\\theta = \\sqrt{1 - 0.6957^2} = 0.7183 \\\\ \\Delta\\theta = \\frac{m\\,d\\lambda}{d\\cos\\theta} = \\frac{2 \\times 6 \\times 10^{-8}}{1.6933 \\times 10^{-4} \\times 0.7183} = 9.86 \\times 10^{-4}\\text{ rad} = 0.0565^\\circ \\approx 3.4'", "body": "Calculate grating spacing d in cm, find cos theta from d sin theta = m lambda, and evaluate Delta theta = m d lambda / (d cos theta). Grating spacing d 1.5 · angle theta 1.5 · angular separation 2."},
            {"type": "mcq", "q": "The angular dispersive power \\( d\\theta / d\\lambda \\) of a diffraction grating is ____.", "options": ["m over (d cos theta)", "d cos theta over m", "m d sin theta", "lambda over d"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Differentiating d sin theta = m lambda gives d theta / d lambda = m / (d cos theta)."},
            {"type": "mcq", "q": "One inch is equal to ____.", "options": ["2.54 cm", "1.54 cm", "3.00 cm", "10.0 cm"], "answer": 0, "time": 45, "practice": "remember-word", "why": "1 inch = 2.54 cm converts lines per inch to grating element in cm."},
            {"type": "mcq", "q": "The wavelengths of the sodium \\( D_1 \\) and \\( D_2 \\) doublet lines are approximately ____.", "options": ["5896 A and 5890 A", "4000 A and 7000 A", "6328 A and 6943 A", "5000 A and 5500 A"], "answer": 0, "time": 45, "practice": "remember-word", "why": "The yellow sodium doublet is at 589.0 nm and 589.6 nm."}
          ]
