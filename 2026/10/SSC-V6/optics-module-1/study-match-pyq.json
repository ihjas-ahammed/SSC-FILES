          "cards": [
            {"type": "question", "label": "PYQ · 4 marks", "title": "Question 27", "marks": 4, "q": "A grating (with 15,000 lines per inch) is illuminated by sodium light. The grating spectrum is observed on the focal plane of a convex lens of focal length 10cm. Calculate the separation between the D1 and D2 lines of sodium. The wavelengths of the D_1 and D_2 lines are 5890 and 5896\\AA respectively."},
            {"type": "eval", "q": "Grating element d, angular dispersion d theta, and linear separation dx = f d theta", "options": [{"t": "d = 2.54/15000 = 1.693 x 10^-4 cm, cos theta1 = 0.937, and linear separation dx = f d theta = 3.78 x 10^-3 cm (0.0378 mm)", "m": 4}, {"t": "Small-angle approximation dx = f d lambda / d = 3.54 x 10^-3 cm used", "m": 3.5}, {"t": "Formula only", "m": 1}, {"t": "Missing or wrong", "m": 0}], "why": "Find grating spacing d, compute angular separation d theta in first order, and multiply by focal length f = 10 cm."},
            {"type": "score", "title": "Q27 · Your marks"},
            {"type": "info", "label": "Answer", "title": "Linear separation dx = 0.0378 mm (3.78 x 10^-3 cm)", "body": "Know first: N-slit Fraunhofer diffraction pattern and grating (14). With \\( d = \\frac{2.54\\text{ cm}}{15000} = 1.693\\times 10^{-4}\\text{ cm} \\) and \\( m = 1 \\), \\( \\sin\\theta = \\frac{\\lambda}{d} = 0.348 \\) so \\( \\cos\\theta = 0.9375 \\). For \\( d\\lambda = 6\\text{ \\AA} = 6\\times 10^{-8}\\text{ cm} \\) and \\( f = 10\\text{ cm} \\), the linear separation in the focal plane is \\( dx = f\\,d\\theta = \\frac{f\\,m\\,d\\lambda}{d\\cos\\theta} = 3.78\\times 10^{-3}\\text{ cm} = 0.0378\\text{ mm} \\).", "tex": "\\Delta x = 3.78 \\times 10^{-3}\\text{ cm} = 0.0378\\text{ mm}"},
            {"type": "math", "label": "Solution", "title": "Calculation of focal-plane linear separation", "tex": "d = \\frac{2.54\\text{ cm}}{15000} = 1.6933 \\times 10^{-4}\\text{ cm}, \\quad f = 10\\text{ cm}, \\quad m = 1 \\\\ \\lambda_1 = 5890\\text{ \\AA}, \\quad \\lambda_2 = 5896\\text{ \\AA}, \\quad d\\lambda = 6 \\times 10^{-8}\\text{ cm} \\\\ \\sin\\theta = \\frac{5.893 \\times 10^{-5}}{1.6933 \\times 10^{-4}} = 0.3480 \\implies \\cos\\theta = \\sqrt{1 - 0.3480^2} = 0.9375 \\\\ \\Delta\\theta = \\frac{m\\,d\\lambda}{d\\cos\\theta} = \\frac{1 \\times 6 \\times 10^{-8}}{1.6933 \\times 10^{-4} \\times 0.9375} = 3.779 \\times 10^{-4}\\text{ rad} \\\\ \\Delta x = f\\Delta\\theta = 10 \\times 3.779 \\times 10^{-4} = 3.78 \\times 10^{-3}\\text{ cm} = 0.0378\\text{ mm}", "body": "Calculate d in cm, evaluate d theta = d lambda / (d cos theta) in first order, and multiply by focal length f = 10 cm. Grating spacing d 1 · angular separation 1.5 · linear separation dx 1.5."},
            {"type": "mcq", "q": "The linear dispersion \\( dx / d\\lambda \\) in the focal plane of a lens of focal length \\( f \\) equals ____.", "options": ["f times (d theta / d lambda)", "(d theta / d lambda) divided by f", "f divided by d lambda", "d cos theta"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Since dx = f d theta, linear dispersion is f (d theta / d lambda) = f m / (d cos theta)."},
            {"type": "mcq", "q": "If a lens of twice the focal length \\( f \\) is used to focus the grating spectrum, the linear separation between the D1 and D2 lines ____.", "options": ["doubles", "halves", "remains unchanged", "vanishes"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Linear separation dx = f Delta theta is directly proportional to f."},
            {"type": "mcq", "q": "In the grating equation \\( d\\sin\\theta = m\\lambda \\), as the diffraction angle \\( \\theta \\) increases, \\( \\cos\\theta \\) decreases and the angular dispersion ____.", "options": ["increases", "decreases", "becomes zero", "becomes negative"], "answer": 0, "time": 45, "practice": "remember-word", "why": "d theta / d lambda = m / (d cos theta) increases as cos(theta) decreases."}
          ]
