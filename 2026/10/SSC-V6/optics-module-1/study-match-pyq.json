            {"type": "mcq", "q": "The undiffracted zero-order beam passing straight through the hologram is proportional to ____.", "options": ["(I_R + I_O) E_R", "E_O", "E_O*", "zero"], "answer": 0, "time": 45, "practice": "remember-word", "why": "The DC transmittance term multiplies E_R without changing its direction."},
            {"type": "mcq", "q": "Because every part of the hologram receives light from the entire object, a small piece of a hologram can reconstruct the ____.", "options": ["whole object with reduced field of view", "corner of the object only", "reference mirror only", "nothing"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Information from each object point is distributed across the entire holographic plate."}
          ]
