          "id": "opt-pyq-n18-q19",
          "title": "Q19 · System matrix of two thin lenses separated by a distance and equivalent focal length (4 marks)",
          "icon": "wave",
          "year": 2018,
          "month": "Nov",
          "unit": 3,
          "units": [3],
