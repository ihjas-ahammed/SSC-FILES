          "cards": [
            {"type": "question", "label": "PYQ · 2 marks", "title": "Question 6", "marks": 2, "q": "Give the grating equation and explain the terms involved."},
            {"type": "eval", "q": "Grating equation d sin theta = m lambda and symbol meanings", "options": [{"t": "(a+b) sin theta = m lambda (or d sin theta = m lambda) and all terms explained", "m": 2}, {"t": "Equation only without explaining terms", "m": 1}, {"t": "Missing or wrong", "m": 0}], "why": "Write the grating equation and define grating element, diffraction angle, order and wavelength."},
            {"type": "score", "title": "Q6 · Your marks"},
            {"type": "info", "label": "Answer", "title": "Diffraction grating equation", "body": "Know first: N-slit Fraunhofer diffraction pattern and grating. For normal incidence, the condition for principal maxima of a diffraction grating is \\( d\\sin\\theta = (a + b)\\sin\\theta = m\\lambda \\). Here \\( d = a + b = 1/N_{\\text{lines}} \\) is the grating element (sum of opaque width \\( a \\) and slit width \\( b \\)), \\( \\theta \\) is the angle of diffraction, \\( m = 0, \\pm 1, \\pm 2, \\dots \\) is the order of the spectrum, and \\( \\lambda \\) is the wavelength.", "tex": "d\\sin\\theta = (a + b)\\sin\\theta = m\\lambda"},
            {"type": "math", "label": "Solution", "title": "Grating law and parameters", "tex": "d\\sin\\theta = m\\lambda, \\quad d = a + b = \\frac{1}{N_0} \\\\ m = 0, \\pm 1, \\pm 2, \\dots", "body": "Equate the path difference d sin theta between adjacent slits to an integral multiple of lambda. Equation 1 · terms explained 1."},
            {"type": "mcq", "q": "The combined width of one transparent slit and one opaque space on a grating is the ____.", "options": ["grating element", "coherence length", "focal length", "half-period zone"], "answer": 0, "time": 45, "practice": "remember-word", "why": "The grating element d = a + b is the spatial period of the rulings."},
            {"type": "mcq", "q": "In the grating equation \\( d\\sin\\theta = m\\lambda \\), \\( m = 0 \\) corresponds to the ____.", "options": ["central principal maximum", "first minimum", "absent spectrum", "Brewster angle"], "answer": 0, "time": 45, "practice": "remember-word", "why": "At m = 0, all wavelengths have zero path difference at theta = 0."},
            {"type": "mcq", "q": "If a grating has \\( N_0 \\) lines per unit length, its grating element \\( d \\) equals ____.", "options": ["1 divided by N0", "N0 squared", "2 N0", "pi times N0"], "answer": 0, "time": 45, "practice": "remember-word", "why": "The spacing between adjacent lines is the reciprocal of the ruling density."}
          ]
        },
