            {"type": "mcq", "q": "A phase change of \\( \\pi \\) occurs when light is reflected at the boundary of an ____.", "options": ["optically denser medium", "optically rarer medium", "absorbing vacuum", "isotropic gas"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Reflection from a medium of higher refractive index reverses the electric field phase by pi."},
            {"type": "mcq", "q": "The interference patterns in reflected and transmitted light from a non-absorbing thin film are ____.", "options": ["complementary to each other", "identical to each other", "independent of thickness", "linearly polarized"], "answer": 0, "time": 45, "practice": "remember-word", "why": "By conservation of energy, maxima in reflection correspond to minima in transmission."}
          ]
        }
      ]
