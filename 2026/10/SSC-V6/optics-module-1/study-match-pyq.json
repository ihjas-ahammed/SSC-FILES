          "units": [7],
          "marks": 2,
          "source": "PYQ Nov 2021 (D 10245) Q13 · also Nov 2022 (CBCSS) Q3, Nov 2022 (D 30197) Q13, Nov 2018 Q20",
          "cards": [
            {"type": "question", "label": "PYQ · 2 marks", "title": "Question 13", "marks": 2, "q": "Describe the conditions to obtain sustained interference pattern."},
            {"type": "eval", "q": "Coherence, same frequency/wavelength, equal amplitudes, small d and large D", "options": [{"t": "At least four conditions (coherent sources, same frequency/wavelength, nearly equal amplitudes, small d, large D) stated", "m": 2}, {"t": "Only two conditions stated", "m": 1}, {"t": "Missing or wrong", "m": 0}], "why": "List the essential conditions for a stationary, high-contrast, well-spaced interference pattern."},
            {"type": "score", "title": "Q13 · Your marks"},
            {"type": "info", "label": "Answer", "title": "Conditions for sustained interference", "body": "Know first: Interference of light waves. To obtain a sustained, distinct interference pattern: (1) the two sources must be coherent (maintain a constant phase difference) and emit continuous waves of the same frequency/wavelength; (2) their amplitudes should be equal or nearly equal for high contrast (\\( I_{\\min} \\approx 0 \\)); (3) the separation \\( d \\) between the sources must be small and the screen distance \\( D \\) large; and (4) if polarized, the waves must be in the same state of polarization.", "tex": "\\delta = \\text{const}, \\quad \\omega_1 = \\omega_2, \\quad a_1 \\approx a_2, \\quad d \\ll D"},
            {"type": "math", "label": "Solution", "title": "Summary of interference conditions", "tex": "1.\\; \\phi_1 - \\phi_2 = \\text{constant (coherent)}, \\quad \\lambda_1 = \\lambda_2 \\\\ 2.\\; a_1 = a_2 \\implies I_{\\min} = (a_1 - a_2)^2 = 0 \\\\ 3.\\; \\beta = \\frac{\\lambda D}{d} \\text{ large} \\implies d \\text{ small, } D \\text{ large}", "body": "State the coherence/monochromaticity condition, equal-amplitude contrast condition, and geometric spacing condition. Conditions 2."},
            {"type": "mcq", "q": "For the dark fringes in an interference pattern to be completely dark, the two interfering waves must have ____.", "options": ["equal amplitudes", "different wavelengths", "orthogonal polarizations", "large slit separation"], "answer": 0, "time": 45, "practice": "remember-word", "why": "I_min = (a1 - a2)^2 = 0 only when a1 = a2."},
            {"type": "mcq", "q": "For an interference pattern to remain stationary in time (sustained), the two sources must be ____.", "options": ["coherent", "incoherent", "polychromatic", "independent lamps"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Constant phase difference keeps the positions of maxima and minima fixed in time."},
            {"type": "mcq", "q": "Two orthogonally polarized light beams cannot form interference fringes because their electric vectors are ____.", "options": ["mutually perpendicular", "parallel", "in phase", "monochromatic"], "answer": 0, "time": 45, "practice": "remember-word", "why": "The dot product E1 . E2 of perpendicular vectors is zero."}
          ]
        },
