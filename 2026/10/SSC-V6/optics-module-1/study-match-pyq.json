          "cards": [
            {"type": "question", "label": "PYQ · 5 marks", "title": "Question 18", "marks": 5, "q": "Using a suitable figure, explain the reconstruction of image in holography."},
            {"type": "eval", "q": "Reconstruction diagram, illumination by reference wave, and virtual/real diffracted images", "options": [{"t": "Clear figure and explanation of illuminating hologram with reference beam to form 3D virtual and real images", "m": 5}, {"t": "Explanation without figure or missing one image type", "m": 3}, {"t": "Brief statement only", "m": 1.5}, {"t": "Missing or wrong", "m": 0}], "why": "Draw the reconstruction setup and explain how diffraction produces the virtual and real images."},
            {"type": "score", "title": "Q18 · Your marks"},
            {"type": "info", "label": "Answer", "title": "Holographic image reconstruction", "body": "Know first: Interference of light waves. To reconstruct the image, the developed hologram (acting as a complex diffraction grating) is illuminated solely by the original coherent reference beam \\( E_R \\) at the same angle used during recording. Diffraction by the recorded interference fringes splits the beam into a direct zero-order beam and two first-order diffracted waves: one diverges as an exact replica of the original object wave \\( E_O \\) to form a 3D virtual image at the original object position, and the conjugate wave converges to form a pseudoscopic real image.", "tex": "T \\cdot E_R = c_0 E_R + c_1 |E_R|^2 E_O + c_1 E_R^2 E_O^*"},
            {"type": "math", "label": "Solution", "title": "Mathematical basis of holographic reconstruction", "tex": "I = |E_R + E_O|^2 = |E_R|^2 + |E_O|^2 + E_R^* E_O + E_R E_O^* \\\\ E_{\\text{trans}} \\propto I \\cdot E_R = (|E_R|^2 + |E_O|^2)E_R + |E_R|^2 E_O + E_R^2 E_O^* \\\\ |E_R|^2 E_O \\to \\text{3D virtual image}, \\quad E_R^2 E_O^* \\to \\text{real image}", "body": "Multiply the recorded intensity pattern by the reconstruction wave ER to show the original wave EO and conjugate wave EO*. Diagram 2 · diffraction explanation 1.5 · virtual/real waves 1.5."},
            {"type": "mcq", "q": "During reconstruction, the developed hologram is illuminated by the ____.", "options": ["reference beam alone", "object beam alone", "white sunlight", "incoherent X-rays"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Illuminating with the coherent reference wave recreates the object wavefront by diffraction."},
            {"type": "mcq", "q": "The reconstructed wave \\( |E_R|^2 E_O \\) diverges from the hologram to form a three-dimensional ____.", "options": ["virtual image", "real image", "zero-order spot", "dark fringe"], "answer": 0, "time": 45, "practice": "remember-word", "why": "It duplicates the original diverging object wave EO, showing full parallax."},
            {"type": "mcq", "q": "A developed hologram reconstructs the wavefront primarily through the phenomenon of ____.", "options": ["diffraction", "double refraction", "total internal reflection", "Brewster reflection"], "answer": 0, "time": 45, "practice": "remember-word", "why": "The recorded interference fringes act as a complex diffraction grating."}
          ]
        },
