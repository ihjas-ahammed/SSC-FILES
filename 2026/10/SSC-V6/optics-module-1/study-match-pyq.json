          "cards": [
            {"type": "question", "label": "PYQ · 4 marks", "title": "Question 18", "marks": 4, "q": "Obtain the system matrix for a thick lens."},
            {"type": "eval", "q": "Refraction matrices R1, R2 and internal translation matrix T", "options": [{"t": "R1 = [[1, -P1], [0, 1]], T = [[1, 0], [t/n2, 1]], and R2 = [[1, -P2], [0, 1]] written with correct order S = R2 T R1", "m": 2}, {"t": "Matrices written in wrong multiplication order", "m": 1}, {"t": "Missing or wrong", "m": 0}], "why": "Write the three elementary 2x2 matrices and set up the product S = R2 T R1."},
            {"type": "eval", "q": "Matrix multiplication to obtain the 2x2 thick-lens system matrix", "options": [{"t": "Complete 2x2 product S = [[1 - P2 t/n2, -(P1 + P2 - P1 P2 t/n2)], [t/n2, 1 - P1 t/n2]] derived", "m": 2}, {"t": "Partial multiplication", "m": 1}, {"t": "Missing or wrong", "m": 0}], "why": "Multiply R2 * T * R1 to obtain the four elements of the thick-lens system matrix."},
            {"type": "score", "title": "Q18 · Your marks"},
            {"type": "info", "label": "Answer", "title": "System matrix for a thick lens", "body": "Know first: The thin lens, principal foci and focal length. A thick lens of axial thickness \\( t \\) and refractive index \\( n_2 \\) placed in a medium \\( n_1 \\) consists of refraction at surface 1 (\\( P_1 = \\frac{n_2 - n_1}{R_1} \\)), translation through \\( t \\) in medium \\( n_2 \\), and refraction at surface 2 (\\( P_2 = \\frac{n_1 - n_2}{R_2} \\)). Multiplying in reverse order \\( S = \\mathcal{R}_2 \\mathcal{T} \\mathcal{R}_1 \\) gives \\( S = \\begin{bmatrix} 1 - \\frac{P_2 t}{n_2} & -\\left(P_1 + P_2 - \\frac{P_1 P_2 t}{n_2}\\right) \\\\ \\frac{t}{n_2} & 1 - \\frac{P_1 t}{n_2} \\end{bmatrix} \\).", "tex": "S = \\begin{bmatrix} 1 - \\frac{P_2 t}{n_2} & -\\left(P_1 + P_2 - \\frac{P_1 P_2 t}{n_2}\\right) \\\\ \\frac{t}{n_2} & 1 - \\frac{P_1 t}{n_2} \\end{bmatrix}"},
            {"type": "math", "label": "Solution", "title": "Derivation of S = R2 T R1 for a thick lens", "tex": "P_1 = \\frac{n_2 - n_1}{R_1}, \\quad P_2 = \\frac{n_1 - n_2}{R_2} \\\\ \\mathcal{R}_1 = \\begin{bmatrix} 1 & -P_1 \\\\ 0 & 1 \\end{bmatrix}, \\quad \\mathcal{T} = \\begin{bmatrix} 1 & 0 \\\\ t/n_2 & 1 \\end{bmatrix}, \\quad \\mathcal{R}_2 = \\begin{bmatrix} 1 & -P_2 \\\\ 0 & 1 \\end{bmatrix} \\\\ \\mathcal{T}\\mathcal{R}_1 = \\begin{bmatrix} 1 & -P_1 \\\\ t/n_2 & 1 - \\frac{P_1 t}{n_2} \\end{bmatrix} \\\\ S = \\mathcal{R}_2\\mathcal{T}\\mathcal{R}_1 = \\begin{bmatrix} 1 & -P_2 \\\\ 0 & 1 \\end{bmatrix}\\begin{bmatrix} 1 & -P_1 \\\\ t/n_2 & 1 - \\frac{P_1 t}{n_2} \\end{bmatrix} = \\begin{bmatrix} 1 - \\frac{P_2 t}{n_2} & -\\left(P_1 + P_2 - \\frac{P_1 P_2 t}{n_2}\\right) \\\\ \\frac{t}{n_2} & 1 - \\frac{P_1 t}{n_2} \\end{bmatrix}", "body": "Write the refraction and translation matrices and multiply S = R2 * T * R1. Elementary matrices 2 · matrix multiplication 2."},
            {
              "type": "derivation",
              "label": "Derivation",
              "title": "System matrix of a thick lens",
              "legend": "Thick lens of thickness t and refractive index n2 bounded by spherical surfaces R1 (pole P1) and R2 (pole P2).",
              "setup": "<svg viewBox=\"0 0 260 180\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"15\" y1=\"90\" x2=\"245\" y2=\"90\" stroke=\"#333\" stroke-width=\"1.2\"/><path d=\"M 95 30 Q 70 90 95 150 L 165 150 Q 190 90 165 30 Z\" fill=\"#e8f0fe\" stroke=\"#1a73e8\" stroke-width=\"1.5\"/><line x1=\"25\" y1=\"70\" x2=\"83\" y2=\"55\" stroke=\"#d93025\" stroke-width=\"1.5\"/><line x1=\"83\" y1=\"55\" x2=\"177\" y2=\"62\" stroke=\"#188038\" stroke-width=\"1.5\"/><line x1=\"177\" y1=\"62\" x2=\"235\" y2=\"90\" stroke=\"#d93025\" stroke-width=\"1.5\"/><text x=\"75\" y=\"105\" font-size=\"10\">P1</text><text x=\"162\" y=\"105\" font-size=\"10\">P2</text><text x=\"125\" y=\"105\" font-size=\"10\">t (n2)</text><text x=\"35\" y=\"105\" font-size=\"10\">n1</text><text x=\"210\" y=\"105\" font-size=\"10\">n1</text></svg>",
              "phases": ["First refraction R1", "Internal translation T", "Second refraction R2", "Full system product"],
              "steps": [
                {"phase": 0, "math": "\\mathcal{R}_1 = \\begin{bmatrix} 1 & -P_1 \\\\ 0 & 1 \\end{bmatrix}, \\quad P_1 = \\frac{n_2 - n_1}{R_1}", "note": "Write the refraction matrix at the first spherical surface of radius R1."},
                {"phase": 1, "math": "\\mathcal{T} = \\begin{bmatrix} 1 & 0 \\\\ t/n_2 & 1 \\end{bmatrix} \\implies \\mathcal{T}\\mathcal{R}_1 = \\begin{bmatrix} 1 & -P_1 \\\\ t/n_2 & 1 - \\frac{P_1 t}{n_2} \\end{bmatrix}", "note": "Left-multiply by the translation matrix for axial thickness t in medium n2."},
                {"phase": 2, "math": "\\mathcal{R}_2 = \\begin{bmatrix} 1 & -P_2 \\\\ 0 & 1 \\end{bmatrix}, \\quad P_2 = \\frac{n_1 - n_2}{R_2}", "note": "Write the refraction matrix at the second spherical surface of radius R2."},
                {"phase": 3, "math": "S = \\mathcal{R}_2\\mathcal{T}\\mathcal{R}_1 = \\begin{bmatrix} 1 - \\frac{P_2 t}{n_2} & -\\left(P_1 + P_2 - \\frac{P_1 P_2 t}{n_2}\\right) \\\\ \\frac{t}{n_2} & 1 - \\frac{P_1 t}{n_2} \\end{bmatrix}", "note": "Left-multiply by R2 to obtain the complete thick-lens system matrix."}
              ],
              "ask": [
                {"q": "In what order are the three elementary matrices multiplied for a ray passing through \\( R_1 \\), then \\( t \\), then \\( R_2 \\)?", "options": ["S = R2 T R1", "S = R1 T R2", "S = T R1 R2", "S = R1 + T + R2"], "answer": 0, "why": "Matrix operators act from right to left on the column ray vector."},
                {"q": "What is the off-diagonal entry in the translation matrix \\( \\mathcal{T} \\) inside the lens of thickness \\( t \\) and index \\( n_2 \\)?", "options": ["t / n2", "n2 * t", "-P1", "0"], "answer": 0, "why": "y2 = y1 + (t/n2) lambda1."},
                {"q": "From the \\( (1,2) \\) element \\( -a \\) of \\( S \\), what is the equivalent optical power \\( P = 1/f \\) of a thick lens in air (\\( n_1 = 1 \\))?", "options": ["P1 + P2 - P1 P2 t / n2", "P1 + P2", "P1 - P2", "P1 P2 t"], "answer": 0, "why": "a = 1/f = P1 + P2 - P1 P2 t / n2 (Gullstrand's equation)."},
                {"q": "What does the thick-lens system matrix reduce to when the thickness \\( t \\to 0 \\)?", "options": ["[[1, -(P1 + P2)], [0, 1]] (the thin-lens matrix)", "The zero matrix", "The identity matrix", "[[0, 1], [1, 0]]"], "answer": 0, "why": "Setting t = 0 recovers S = [[1, -1/f], [0, 1]] with 1/f = P1 + P2."}
              ]
            },
            {"type": "mcq", "q": "According to Gullstrand's equation from the thick-lens matrix, the equivalent power \\( P \\) is ____.", "options": ["P1 + P2 - P1 P2 t / n2", "P1 + P2 + P1 P2 t", "P1 P2 / t", "(P1 + P2) / n2"], "answer": 0, "time": 45, "practice": "remember-word", "why": "The (1,2) element of S is -P = -(P1 + P2 - P1 P2 t / n2)."},
            {"type": "mcq", "q": "In the translation matrix for a lens of thickness \\( t \\) and refractive index \\( n_2 \\), the reduced thickness is ____.", "options": ["t divided by n2", "t times n2", "t minus n2", "n2 divided by t"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Because lambda = n2 * alpha, Delta y = t * alpha = (t/n2) * lambda."},
            {"type": "mcq", "q": "A thick lens is formed by two refractions separated by a ____.", "options": ["translation through thickness t", "diffraction grating", "polaroid analyzer", "mirror reflection"], "answer": 0, "time": 45, "practice": "remember-word", "why": "Between the two curved faces, the ray translates through a homogeneous medium of thickness t."}
          ]
