  window.PYHTML = r => {
    let h = `<div class="body"><pre class="py${r.ok ? '' : ' err'}">${esc((r.out || '') + (r.err ? ((r.out ? '\n' : '') + r.err) : '')) || (r.img ? '' : '(no output)')}</pre>`;
