    integrate: '\\textstyle\\int d{w}', ln: '\\ln', exp: 'e^{(\\;)}', apply: '{fn}(\\;)',
    substitute: '\\text{sub } {b}', expand: '\\text{expand}', factor: '\\text{factor}', simplify: '\\text{simplify}',
