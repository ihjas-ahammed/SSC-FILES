/* ══════════════ ANIMATED DERIVATION & FIGURE STYLES ══════════════ */
/* ---------- Figure ---------- */
.fg-host {
  position: relative; display: block; padding: 0; overflow: hidden;
  --fg-pad: 10px; --fg-pad-top: 34px;
  background: color-mix(in srgb, var(--lav) 62%, var(--card));
}
.fg-host > .fg-svg {
  position: absolute; inset: 0; width: 100%; height: 100%; max-height: none; overflow: visible;
  font-size: var(--fg-fs, 14px); pointer-events: none;
}
.fg-svg path, .fg-svg circle { vector-effect: non-scaling-stroke; }

/* every part fades between off, on, dim and focus; draw-in is done in JS */
.fg-part { transition: opacity 0.45s ease; }
.fg-part.is-off { opacity: 0; }
.fg-part.is-dim { opacity: 0.22; }
.fg-instant .fg-part, .fg-instant .fg-part * { transition: none !important; }

.fg-stroke { fill: none; stroke: var(--violet); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: stroke 0.4s ease, stroke-width 0.4s ease; }
.fg-head { fill: var(--violet); stroke: none; transition: fill 0.4s ease; }
.fg-fill { fill: var(--violet); fill-opacity: 0.1; stroke: none; transition: fill 0.4s ease, fill-opacity 0.4s ease; }
.fg-dot { fill: var(--violet); stroke: var(--card); stroke-width: 1.6; transition: fill 0.4s ease; }
.fg-hatch { fill: none; stroke: var(--ink-2); stroke-width: 1.1; stroke-linecap: round; opacity: 0.55; }
.fg-ext { fill: none; stroke: var(--ink-2); stroke-width: 1.3; stroke-linecap: round; }

.fg-axis .fg-stroke { stroke: var(--ink-2); stroke-width: 1.3; }
.fg-axis .fg-head { fill: var(--ink-2); }
.fg-mirror .fg-stroke { stroke: var(--ink); stroke-width: 2.8; }
.fg-ray .fg-stroke { stroke-width: 2.2; }
.fg-normal .fg-stroke { stroke: var(--ink-2); stroke-width: 1.4; stroke-dasharray: 5 4; }
.fg-guide .fg-stroke { stroke: var(--ink-2); stroke-width: 1.4; stroke-dasharray: 3 3; }
.fg-dim .fg-stroke { stroke: var(--ink-2); stroke-width: 1.3; }
.fg-dim .fg-head { fill: var(--ink-2); }
.fg-angle .fg-stroke { stroke-width: 1.7; }
.fg-angle .fg-fill { fill-opacity: 0.14; }
.fg-polygon .fg-stroke { stroke: var(--hl); stroke-width: 2.2; }
.fg-polygon .fg-fill { fill: var(--amber); fill-opacity: 0.2; }

/* focus: the accent colour, a little heavier */
.fg-part.is-focus .fg-stroke { stroke: var(--hl); }
.fg-part.is-focus.fg-line .fg-stroke, .fg-part.is-focus.fg-dim .fg-stroke { stroke-width: 2.4; }
.fg-part.is-focus .fg-head, .fg-part.is-focus .fg-dot { fill: var(--hl); }
.fg-part.is-focus .fg-ext { stroke: var(--hl); }
.fg-part.is-focus.fg-angle .fg-stroke { stroke-width: 2.2; }
.fg-part.is-focus.fg-angle .fg-fill { fill: var(--amber); fill-opacity: 0.32; }

/* labels: fixed pixel size, italic like the symbols on the board, with a halo so lines never cut them */
.fg-label {
  font-family: "STIX Two Text", "Cambria Math", "Times New Roman", "Noto Serif", "DejaVu Serif", serif;
  font-style: italic; font-weight: 600; fill: var(--ink);
  paint-order: stroke; stroke: color-mix(in srgb, var(--lav) 62%, var(--card)); stroke-width: 4px; stroke-linejoin: round;
  transition: fill 0.4s ease;
}
.fg-label .fg-sub, .fg-label .fg-sup { font-size: 70%; }
/* MathJax labels: glyphs fill with currentColor; the halo is a stroke painted under the fill */
.fg-label { color: var(--ink); }
.fg-label > svg, .fg-label > svg > g { stroke: inherit !important; stroke-width: 0; }
.fg-label > svg path { stroke-width: 3.5px; vector-effect: non-scaling-stroke; paint-order: stroke; stroke-linejoin: round; }
.fg-part.is-focus .fg-label { color: var(--hl); }
.fg-plate { fill: color-mix(in srgb, var(--lav) 62%, var(--card)); stroke: none; }
.fg-point .fg-label { font-style: normal; font-weight: 700; }
.fg-dim .fg-label { font-size: 92%; }
.fg-part.is-focus .fg-label { fill: var(--hl); font-weight: 800; }

/* caption: one line in the top-left corner, says what the figure is showing now */
.fg-cap { display: none !important;

  position: absolute; left: 8px; top: 7px; max-width: calc(100% - 16px); z-index: 1;
  font-size: 12.5px; line-height: 1.3; font-weight: 700; color: var(--ink);
  padding: 4px 10px; border-radius: 999px; background: var(--card); box-shadow: inset 0 0 0 1px var(--line);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  opacity: 0; transform: translateY(-4px); transition: opacity 0.25s ease, transform 0.25s ease;
}
.fg-cap.is-on { opacity: 1; transform: none; }
.fg-cap.is-on.is-swap { opacity: 0; transform: translateY(-3px); }
.fg-cap sub, .fg-cap sup { font-size: 72%; line-height: 0; }

/* the old phone rule forces 15px on every setup label; the figure sizes its own labels */
.mf-v2 .mf-setup .fg-svg text, .mf-v2 .mf-front-art .fg-svg text { font-size: inherit !important; font-weight: 600; }
.mf-v2 .mf-setup .fg-svg .fg-point text { font-weight: 700; }


