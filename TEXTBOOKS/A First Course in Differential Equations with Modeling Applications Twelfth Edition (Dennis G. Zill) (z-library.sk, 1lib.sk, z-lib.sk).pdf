   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">The international balloon fiesta is an annual event in Bristol. This photo captures the afternoon flight as the balloons come over the Clifton Suspension Bridge. Photo taken in 2012.</rdf:li>
    </rdf:Alt>
   </dc:description>
