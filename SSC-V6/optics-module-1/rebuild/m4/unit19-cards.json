  "cards": [
    {
      "type": "intuition",
      "term": "optics-m4-polarizer",
      "title": "A filter that passes one vibration",
      "meaning": "A polarizer turns unpolarized light into plane-polarized light.",
      "points": [
        "Unpolarized light vibrates in every direction across the beam.",
        "<b>Transmission axis</b>: only vibrations parallel to it pass.",
        "Blocked vibrations are absorbed (sheet) or sent sideways (Nicol prism).",
        "The output is plane-polarized, with half the input intensity."
      ]
    },
    {
      "type": "info",
      "label": "01 · §20.8 Definition",
      "title": "What is a polarizer?",
      "defines": [
        "optics-m4-polarizer"
      ],
      "body": "A polarizer is an optical element that transforms unpolarized light into polarized light by selective absorption or double refraction.",
      "points": [
        "<b>Polaroid sheet</b>: absorbs vibrations parallel to the iodine chains.",
        "<b>Nicol prism</b>: double refraction sends the o-ray sideways; the e-ray passes.",
        "The E-vector of the output lies along the transmission axis."
      ],
