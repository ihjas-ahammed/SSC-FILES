      "q": "Crossed polarizer and analyzer have their transmission axes ______ to each other.",
      "answer": "perpendicular|at right angles|orthogonal",
      "why": "Perpendicular axes extinguish the polarized light leaving the polarizer."
    },
    {
      "type": "number",
      "label": "Quiz · Number",
      "time": 60,
      "q": "Unpolarized light, \\(I_0 = 80\\), passes a polarizer, then an analyzer at \\(60^\\circ\\). Final intensity?",
      "answer": 10,
      "tolerance": 0,
      "unit": "",
      "why": "The polarizer halves it to 40; then \\(40\\cos^2 60^\\circ = 10\\)."
    }
