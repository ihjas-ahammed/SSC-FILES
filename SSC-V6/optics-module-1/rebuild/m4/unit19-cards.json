    {
      "type": "intuition",
      "term": "optics-m4-analyzer",
      "title": "The same filter used to test light",
      "meaning": "An analyzer is a polarizer used to find the plane of vibration of plane-polarized light.",
      "points": [
        "Made the same way as a polarizer; only its role differs.",
        "Rotating it changes the transmitted intensity.",
        "Two maxima and two zeros per turn means plane-polarized light."
      ]
    },
    {
      "type": "info",
      "label": "02 · §20.8.2 Definition",
      "title": "What is an analyzer?",
      "defines": [
        "optics-m4-analyzer"
      ],
      "body": "An analyzer is an optical element used to identify the plane of vibration of plane-polarized light.",
      "points": [
        "Fabrication is the same as a polarizer; the role differs.",
        "Both are characterized by a transmission axis.",
        "Used to examine light from emission or reflection.",
        "Parallel axes pass the light; crossed axes extinguish it."
      ],
