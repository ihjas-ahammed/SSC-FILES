  "glossary": [
    {
      "id": "optics-m4-polarizer",
      "term": "polarizer",
      "definition": "An optical element that transforms unpolarized light into polarized light by selective absorption or double refraction.",
      "example": "A Polaroid sheet or a Nicol prism."
    },
    {
      "id": "optics-m4-analyzer",
      "term": "analyzer",
      "definition": "A polarizer used to identify the plane of vibration of plane-polarized light.",
      "example": "A second Polaroid sheet placed after the polarizer."
    },
    {
      "id": "optics-m4-transmission-axis",
      "term": "transmission axis",
      "definition": "The specific direction of a polarizer or analyzer along which vibrations are transmitted.",
      "example": "Light leaving a Polaroid sheet has its E-vector along the axis."
    },
    {
      "id": "optics-m4-crossed-polarizers",
      "term": "crossed polarizers",
      "definition": "A polarizer and analyzer whose transmission axes are perpendicular, so the analyzer extinguishes the light.",
      "example": "Axes at 90° give zero transmitted intensity."
    },
    {
      "id": "optics-m4-malus-law",
      "term": "Malus' law",
      "definition": "The intensity of plane-polarized light transmitted by an analyzer is proportional to the square of the cosine of the angle between the light's plane of polarization and the transmission axis.",
      "example": "At 60°, the transmitted intensity is \\(I_1\\cos^2 60^\\circ = I_1/4\\)."
    },
    {
      "id": "optics-m4-polarizer-light-types",
      "term": "polarizer and light types",
      "definition": "Turning a polarizer changes the transmitted intensity differently for each polarization state of the incident light.",
      "example": "Circular light stays constant; plane-polarized light varies from zero to maximum."
    }
  ]
}
