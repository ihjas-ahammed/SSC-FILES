    {
      "type": "intuition",
      "term": "optics-m4-malus-law",
      "title": "Output falls as the angle grows",
      "meaning": "Malus' law gives the analyzer output from the angle between the light's plane and its axis.",
      "points": [
        "<b>Parallel axes</b> (0°): the full value \\(I_1\\) passes.",
        "<b>Crossed axes</b> (90°): no light passes.",
        "Between 0° and 90°: partial transmission, falling steadily."
      ]
    },
    {
      "type": "info",
      "label": "03 · §20.9 Definition",
      "title": "What is Malus' law?",
      "defines": [
        "optics-m4-malus-law"
      ],
      "body": "Malus' law: the transmitted intensity of plane-polarized light is proportional to \\(\\cos^2\\theta\\), where \\(\\theta\\) is the angle to the transmission axis.",
      "points": [
        "Malus found this in 1809.",
        "It applies to plane-polarized light falling on the analyzer.",
        "\\(\\theta\\) is the angle between the light's plane of polarization and the axis.",
        "Gives two maxima and two zeros in one full turn of the analyzer."
      ],
