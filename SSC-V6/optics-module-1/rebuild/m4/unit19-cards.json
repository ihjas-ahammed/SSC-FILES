    {
      "type": "intuition",
      "term": "optics-m4-crossed-polarizers",
      "title": "Two filters at right angles block light",
      "meaning": "Crossed polarizers are a polarizer and analyzer with perpendicular transmission axes.",
      "points": [
        "The analyzer extinguishes the light leaving the polarizer.",
        "<b>Perpendicular</b> axes: zero intensity.",
        "Turning the analyzer on past 90° lets light return."
      ]
    },
