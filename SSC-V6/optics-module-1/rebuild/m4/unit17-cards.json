    {
      "type": "intuition",
      "term": "optics-m4-circular-polarisation",
      "title": "E vector that turns at constant size",
      "meaning": "In circularly polarised light the E vector keeps its size and its tip traces a circle.",
      "points": [
        "The E vector turns at a constant rate about the direction of propagation.",
        "It completes one revolution within one wavelength.",
        "No direction of oscillation is preferred."
      ]
    },
    {
      "type": "info",
      "label": "04 · §20.5.2 Definition",
      "title": "What is circularly polarised light?",
      "defines": [
        "optics-m4-circular-polarisation"
      ],
      "body": "Circularly polarised light is light whose electric vector keeps constant magnitude and rotates at a constant rate about the propagation direction.",
      "points": [
        "<b>Made of</b>: two coherent linear waves of equal amplitude, in perpendicular planes.",
        "<b>Phase</b>: the two waves are 90° out of phase.",
        "<b>Right</b>: E rotates clockwise, seen by an observer looking back at the source.",
        "<b>Left</b>: E rotates anticlockwise, seen the same way."
      ],
