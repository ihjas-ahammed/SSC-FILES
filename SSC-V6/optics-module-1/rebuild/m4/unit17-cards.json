    {
      "type": "intuition",
      "term": "optics-m4-unpolarised-light",
      "title": "Light whose E vector points every way",
      "meaning": "Unpolarised light has its E vector oscillating in all possible planes perpendicular to the beam.",
      "points": [
        "Sunlight, an incandescent lamp and a candle flame all give unpolarised light.",
        "The E direction changes randomly, on a scale of \\(10^{-14}\\) s.",
        "Each wave packet (about \\(10^{-8}\\) s) has its own plane; the planes are uncorrelated."
      ]
    },
    {
      "type": "info",
      "label": "02 · §20.3 Definition",
      "title": "What is unpolarised light?",
      "defines": [
        "optics-m4-unpolarised-light"
      ],
      "body": "Unpolarised light is light whose electric vector oscillates in all possible planes perpendicular to the beam direction.",
      "points": [
        "<b>Half and half</b>: on average, half the vibrations are horizontal and half vertical.",
        "<b>Incoherent</b>: the two components have a randomly changing phase difference.",
        "<b>Symmetric</b> about the ray direction: no preferred direction of oscillation.",
        "<b>Partially polarised</b> light is a mixture of plane polarised and unpolarised light (§20.5.4)."
      ],
