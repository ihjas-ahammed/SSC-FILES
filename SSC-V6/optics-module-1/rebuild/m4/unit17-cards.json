    {
      "type": "intuition",
      "term": "optics-m4-plane-polarisation",
      "title": "E vector that keeps one direction",
      "meaning": "In plane polarised light the E vector stays on one fixed line while its size changes.",
      "points": [
        "The direction of E at a given point does not change with time.",
        "Its magnitude varies sinusoidally with time.",
        "Vertical: E points up or down. Horizontal: E points right or left."
      ]
    },
    {
      "type": "info",
      "label": "03 · §20.5.1 Definition",
      "title": "What is plane polarised light?",
      "defines": [
        "optics-m4-plane-polarisation"
      ],
      "body": "Plane polarised light is light whose electric vector oscillates strictly in a single plane perpendicular to the direction of propagation.",
      "points": [
        "<b>Also called</b> linearly polarised light.",
        "<b>Any angle</b>: a combination of horizontal and vertical waves, in phase or 180° out of phase.",
        "<b>Coherent</b>: the two component waves must be coherent.",
        "<b>Diagram</b>: dots = E horizontal (perpendicular to the paper); arrows = E vertical (in the paper)."
      ],
