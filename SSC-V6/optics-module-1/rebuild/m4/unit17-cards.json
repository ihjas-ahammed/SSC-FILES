  "cards": [
    {
      "type": "intuition",
      "term": "optics-m4-polarisation",
      "title": "Giving a light wave one preferred direction",
      "meaning": "Polarisation is the one-sidedness a transverse light wave gains when its vibrations have a preferred direction.",
      "points": [
        "<b>Transverse</b> waves vibrate at right angles to travel, so they have a preferred direction.",
        "<b>Longitudinal</b> waves vibrate along travel, so they cannot be polarised.",
        "Ordinary sources mix random vibration planes, which hides the transverse nature.",
        "A polariser removes that symmetry and leaves one direction of vibration."
      ]
    },
    {
      "type": "info",
      "label": "01 · §20.2 Definition",
      "title": "What is polarisation?",
      "defines": [
        "optics-m4-polarisation"
      ],
      "body": "Polarisation is the process of removing the symmetry of a light wave about its direction of propagation, leaving one preferred direction.",
      "points": [
        "<b>E vector</b>: polarisation describes the orientation of the electric field vector E.",
        "<b>Transverse only</b>: longitudinal waves have no directional property, so they cannot be polarised.",
        "<b>Light</b> is transverse: E and B are perpendicular to each other and to the travel direction.",
        "Light in perpendicular planes does not interfere (Arago and Fresnel, 1816)."
      ],
