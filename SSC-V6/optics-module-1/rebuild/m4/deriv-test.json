   "phases": [
    {
     "name": "Two waves",
     "why": "two coherent perpendicular waves"
    },
    {
     "name": "In phase: line",
     "why": "in phase or 180° apart gives a fixed direction"
    },
    {
     "name": "Equal, 90° apart: circle",
     "why": "equal amplitudes, 90° apart: constant size, turning direction"
    },
    {
     "name": "Unequal: ellipse",
     "why": "unequal amplitudes: elliptical"
    }
   ],
   "steps": [
    {
     "phase": "Two waves",
     "tex": "E_z = E_1\\cos\\omega t",
     "note": "Resolve the light into two coherent waves along \\(z\\) and \\(y\\). The \\(z\\)-wave has amplitude \\(E_1\\).",
     "figure": {
      "focus": [
       "axZ"
      ],
      "keep": [
       "axY"
      ],
      "caption": "z-wave: E_z = E_1 cos ωt"
     }
    },
    {
     "tex": "E_y = E_2\\cos(\\omega t+\\delta)",
     "move": {
      "type": "define",
      "label": "Add the \\(y\\)-wave with phase difference \\(\\delta\\)"
     },
     "note": "The \\(y\\)-wave has amplitude \\(E_2\\) and runs a phase \\(\\delta\\) ahead of the \\(z\\)-wave.",
     "figure": {
      "focus": [
       "axY"
      ],
      "keep": [
       "axZ"
      ],
      "caption": "y-wave: E_y = E_2 cos(ωt + δ)"
     }
    },
    {
     "phase": "In phase: line",
     "tex": "E_y = \\frac{E_2}{E_1}E_z",
     "move": {
      "type": "substitute",
      "by": "\\delta = 0"
     },
     "note": "With \\(\\delta=0\\) both waves carry the same \\(\\cos\\omega t\\), so \\(E_y\\) is a fixed multiple of \\(E_z\\).",
     "ask": {
      "q": "If \\(\\delta=0\\), what is \\(E_y/E_z\\) at every instant?",
      "options": [
       "\\(E_2/E_1\\), a constant",
       "\\(\\cos\\omega t\\)",
       "\\(\\tan\\omega t\\)",
       "Zero"
      ],
      "answer": 0,
      "why": "Both factors \\(\\cos\\omega t\\) cancel, leaving the ratio of amplitudes."
     },
     "figure": {
      "focus": [
       "lin"
      ],
      "keep": [
       "axZ",
       "axY"
      ],
      "caption": "δ = 0: the tip moves along a line"
     }
    },
    {
     "tex": "\\tan\\theta = \\frac{E_2}{E_1}",
     "move": {
      "type": "identity",
      "label": "Tangent in the right triangle with legs \\(E_1\\), \\(E_2\\)"
     },
     "note": "In the right triangle the angle \\(\\theta\\) of \\(\\vec E\\) from the \\(z\\)-axis has opposite side \\(E_2\\) and adjacent side \\(E_1\\). It never changes.",
     "ask": {
      "q": "\\(\\theta\\) is fixed in time. What is the light?",
      "options": [
       "Linearly (plane) polarised",
       "Circularly polarised",
       "Elliptically polarised",
       "Unpolarised"
      ],
      "answer": 0,
      "why": "E keeps one direction and only its size oscillates."
     },
     "figure": {
      "focus": [
       "triL",
       "rtL",
       "thL",
       "E1d",
       "E2d"
      ],
      "keep": [
       "lin"
      ],
      "caption": "tan θ = opposite / adjacent = E_2/E_1"
     }
    },
    {
     "tex": "E_y = -\\frac{E_2}{E_1}E_z",
     "move": {
      "type": "substitute",
      "by": "\\delta = \\pi"
     },
     "note": "For \\(\\delta=\\pi\\) (\\(180^\\circ\\) out of phase) \\(\\cos(\\omega t+\\pi)=-\\cos\\omega t\\). The line tilts the other way, still plane polarised.",
     "figure": {
      "focus": [
       "lin2"
      ],
      "keep": [
       "lin",
       "axZ",
       "axY"
      ],
      "caption": "δ = 180°: line tilts the other way"
     }
    },
    {
     "phase": "Equal, 90° apart: circle",
     "tex": "E_z = E_0\\cos\\omega t",
     "move": {
      "type": "substitute",
      "by": "E_1 = E_0"
     },
     "note": "Now take equal amplitudes: \\(E_1=E_0\\).",
     "figure": {
      "focus": [
       "Ezd",
       "Evec"
      ],
      "keep": [
       "axZ",
       "axY"
      ],
      "caption": "Equal amplitudes: E_1 = E_2 = E_0"
     }
    },
    {
     "tex": "E_y = E_0\\cos(\\omega t-90^\\circ)",
     "move": {
      "type": "substitute",
      "by": "E_2 = E_0,\\ \\delta = -90^\\circ"
     },
     "note": "Take \\(E_2=E_0\\) and put the \\(y\\)-wave \\(90^\\circ\\) out of phase (\\(\\delta=-90^\\circ\\)).",
     "figure": {
      "focus": [
       "Eyd"
      ],
      "keep": [
       "Ezd",
       "Evec"
      ],
      "caption": "y-wave a quarter cycle out of phase"
     }
    },
    {
     "tex": "E_y = E_0\\sin\\omega t",
     "move": {
      "type": "identity",
      "by": "\\cos(x-90^\\circ)=\\sin x"
     },
     "note": "A cosine delayed by a quarter cycle is a sine: when \\(E_z\\) is largest, \\(E_y\\) is zero.",
     "figure": {
      "focus": [
       "Eyd"
      ],
      "keep": [
       "Ezd",
       "Evec"
      ],
      "caption": "E_y = E_0 sin ωt"
     }
    },
    {
     "tex": "E^2 = E_z^2 + E_y^2",
     "move": {
      "type": "identity",
      "label": "Pythagoras in the right triangle \\(E_z\\), \\(E_y\\), \\(E\\)"
     },
     "note": "The two components are the legs of a right triangle and the resultant \\(E\\) is its hypotenuse.",
     "ask": {
      "q": "In the right triangle, \\(E^2\\) equals what?",
      "options": [
       "\\(E_z^2+E_y^2\\)",
       "\\(E_z+E_y\\)",
       "\\(E_z^2-E_y^2\\)",
       "\\(E_zE_y\\)"
      ],
      "answer": 0,
      "why": "Hypotenuse squared is the sum of the squared legs."
     },
     "figure": {
      "focus": [
       "triC",
       "rtC",
       "Ezd",
       "Eyd",
       "Evec"
      ],
      "keep": [
       "axZ",
       "axY"
      ],
      "caption": "Pythagoras: E² = E_z² + E_y²"
     }
    },
    {
     "tex": "E^2 = E_0^2\\cos^2\\omega t + E_0^2\\sin^2\\omega t",
     "move": {
      "type": "substitute",
      "by": "E_z = E_0\\cos\\omega t,\\ E_y = E_0\\sin\\omega t"
     },
     "note": "Put in the two components.",
     "figure": {
      "focus": [
       "Evec"
      ],
      "keep": [
       "Ezd",
       "Eyd",
       "axZ",
       "axY"
      ],
      "caption": "Insert E_z and E_y"
     }
    },
    {
     "tex": "E^2 = E_0^2",
     "move": {
      "type": "identity",
      "by": "\\cos^2\\omega t+\\sin^2\\omega t = 1"
     },
     "note": "\\(\\cos^2+\\sin^2=1\\): the size of \\(\\vec E\\) is constant, so its tip lies on a circle of radius \\(E_0\\).",
     "ask": {
      "q": "What is \\(\\cos^2\\omega t+\\sin^2\\omega t\\)?",
      "options": [
       "1",
       "0",
       "2",
       "\\(\\cos 2\\omega t\\)"
      ],
      "answer": 0,
      "why": "It is the basic trig identity."
     },
     "figure": {
      "focus": [
       "circ"
      ],
      "keep": [
       "Evec",
       "axZ",
       "axY"
      ],
      "caption": "|E| constant: tip on a circle"
     }
    },
    {
     "tex": "\\tan\\varphi = \\frac{E_y}{E_z}",
     "move": {
      "type": "identity",
      "label": "Tangent in the right triangle with legs \\(E_z\\), \\(E_y\\)"
     },
     "note": "Let \\(\\varphi\\) be the angle of \\(\\vec E\\) from the \\(z\\)-axis: opposite side \\(E_y\\), adjacent side \\(E_z\\).",
     "ask": {
      "q": "In this triangle, what is \\(\\tan\\varphi\\)?",
      "options": [
       "\\(E_y/E_z\\)",
       "\\(E_z/E_y\\)",
       "\\(E_y/E\\)",
       "\\(E_z/E\\)"
      ],
      "answer": 0,
      "why": "Tangent is opposite over adjacent."
     },
     "figure": {
      "focus": [
       "triC",
       "rtC",
       "phi",
       "Eyd",
       "Ezd"
      ],
      "keep": [
       "Evec",
       "circ"
      ],
      "caption": "tan φ = opposite / adjacent"
     }
    },
    {
     "tex": "\\tan\\varphi = \\tan\\omega t",
     "move": {
      "type": "substitute",
      "by": "\\frac{E_y}{E_z} = \\frac{\\sin\\omega t}{\\cos\\omega t}"
     },
     "note": "\\(E_y/E_z=\\sin\\omega t/\\cos\\omega t=\\tan\\omega t\\).",
     "figure": {
      "focus": [
       "phi"
      ],
      "keep": [
       "Evec",
       "circ"
      ],
      "caption": "E_y/E_z = tan ωt"
     }
    },
    {
     "tex": "\\varphi = \\omega t",
     "move": {
      "type": "apply",
      "fn": "\\tan^{-1}"
     },
     "note": "The angle grows steadily with time: \\(\\vec E\\) turns at constant rate \\(\\omega\\), a full turn per period. This is circular polarisation.",
     "figure": {
      "focus": [
       "phi",
       "Evec"
      ],
      "keep": [
       "circ",
       "axZ",
       "axY"
      ],
      "caption": "φ = ωt: E rotates at constant rate"
     }
    },
    {
     "phase": "Unequal: ellipse",
     "tex": "\\left(\\frac{E_z}{E_1}\\right)^2 + \\left(\\frac{E_y}{E_2}\\right)^2 = 1",
     "move": {
      "type": "identity",
      "by": "\\cos^2\\omega t+\\sin^2\\omega t = 1"
     },
     "note": "If \\(E_1\\neq E_2\\) (and \\(\\delta=-90^\\circ\\)), divide each component by its own amplitude: the tip traces an ellipse. Other phases \\(\\delta\\) also give ellipses.",
     "figure": {
      "focus": [
       "ell",
       "Ead",
       "Ebd"
      ],
      "keep": [
       "axZ",
       "axY"
      ],
      "caption": "Unequal amplitudes: elliptical"
     }
    }
   ]
  },
