   "phases": [
    {
     "name": "Brewster angle",
     "why": "find the polarising angle of glass"
    },
    {
     "name": "Tilt of the plates",
     "why": "tilt the plates so axial light meets them at θ_B"
    },
    {
     "name": "Filtering",
     "why": "each surface removes s-light"
    }
   ],
   "steps": [
    {
     "phase": "Brewster angle",
     "tex": "\\tan\\theta_B = \\mu",
     "note": "Brewster\\'s law (Eq. 20.6): at \\(\\theta_B\\) the reflected light is fully polarised. \\(\\mu\\) is the index of the glass.",
     "figure": {
      "focus": [
       "normal",
       "inc",
       "thB"
      ],
      "keep": [
       "plate",
       "O"
      ],
      "caption": "Incidence at θ_B from the normal"
     }
    },
    {
     "tex": "\\theta_B = \\tan^{-1}\\mu",
     "move": {
      "type": "apply",
      "fn": "\\tan^{-1}"
     },
     "note": "Take the inverse tangent of both sides.",
     "figure": {
      "focus": [
       "thB"
      ],
      "keep": [
       "normal",
       "inc",
       "plate"
      ],
      "caption": "θ_B = tan⁻¹ μ"
     }
    },
    {
     "tex": "\\theta_B = \\tan^{-1}(1.54)",
     "move": {
      "type": "substitute",
      "by": "\\mu = 1.54"
     },
     "note": "For glass take \\(\\mu=1.54\\), chosen so the numbers match the book\\'s Fig. 20.16.",
     "figure": {
      "focus": [
       "thB"
      ],
      "keep": [
       "normal",
       "inc",
       "plate"
      ],
      "caption": "Glass: μ = 1.54"
     }
    },
    {
     "tex": "\\theta_B \\approx 57^\\circ",
     "move": {
      "type": "evaluate",
      "by": "\\tan^{-1}(1.54)"
     },
     "note": "\\(\\tan 57^\\circ\\approx 1.54\\), so the beam must meet each plate at \\(57^\\circ\\) to its normal.",
     "ask": {
      "q": "Which angle has a tangent of about 1.54?",
      "options": [
       "\\(57^\\circ\\)",
       "\\(33^\\circ\\)",
       "\\(45^\\circ\\)",
       "\\(90^\\circ\\)"
      ],
      "answer": 0,
      "why": "\\(\\tan 57^\\circ\\approx1.54\\)."
     },
     "figure": {
      "focus": [
       "thB"
      ],
      "keep": [
       "normal",
       "inc",
       "plate"
      ],
      "caption": "θ_B ≈ 57°"
     }
    },
    {
     "phase": "Tilt of the plates",
     "tex": "\\alpha + \\theta_B = 90^\\circ",
     "move": {
      "type": "identity",
      "label": "The normal is \\(\\perp\\) to the plate: \\(\\alpha\\) and \\(\\theta_B\\) fill a right angle"
     },
     "note": "The normal is perpendicular to the plate. The beam (along the axis) splits this right angle into \\(\\theta_B\\) and \\(\\alpha\\), the angle between plate and axis.",
     "ask": {
      "q": "The normal makes what angle with the plate?",
      "options": [
       "\\(90^\\circ\\)",
       "\\(0^\\circ\\)",
       "\\(45^\\circ\\)",
       "\\(\\theta_B\\)"
      ],
      "answer": 0,
      "why": "A normal is perpendicular to the surface."
     },
     "figure": {
      "focus": [
       "quarter",
       "rtQ",
       "thB",
       "alpha"
      ],
      "keep": [
       "normal",
       "inc",
       "plate"
      ],
      "caption": "Right angle = θ_B + α"
     }
    },
    {
     "tex": "\\alpha = 90^\\circ - \\theta_B",
     "move": {
      "type": "subtract",
      "by": "\\theta_B"
     },
     "note": "Subtract \\(\\theta_B\\).",
     "figure": {
      "focus": [
       "alpha",
       "thB"
      ],
      "keep": [
       "quarter",
       "inc",
       "plate"
      ],
      "caption": "α = 90° − θ_B"
     }
    },
    {
     "tex": "\\alpha = 90^\\circ - 57^\\circ",
     "move": {
      "type": "substitute",
      "by": "\\theta_B \\approx 57^\\circ"
     },
     "note": "Put in \\(\\theta_B\\approx57^\\circ\\).",
     "figure": {
      "focus": [
       "alpha"
      ],
      "keep": [
       "quarter",
       "inc",
       "plate"
      ],
      "caption": "Put in θ_B = 57°"
     }
    },
    {
     "tex": "\\alpha \\approx 33^\\circ",
     "move": {
      "type": "evaluate",
      "by": "90^\\circ-57^\\circ"
     },
     "note": "So the plates are inclined at about \\(33^\\circ\\) to the tube axis, as the book states.",
     "figure": {
      "focus": [
       "alpha",
       "plate",
       "tube"
      ],
      "keep": [
       "inc",
       "O"
      ],
      "caption": "Plates inclined about 33° to the axis"
     }
    },
    {
     "phase": "Filtering",
     "tex": "\\theta_{\\text{inc}} = \\theta_B",
     "move": {
      "type": "evaluate",
      "by": "\\alpha = 33^\\circ"
     },
     "note": "Light along the axis then meets every plate at \\(\\theta_B\\). Each surface reflects only the \\(s\\)-component and none of the \\(p\\)-component, so the \\(s\\)-part is filtered out. After about 15 plates only the \\(p\\)-component (parallel to the plane of incidence) is left.",
     "ask": {
      "q": "What does the transmitted beam consist of after ~15 plates?",
      "options": [
       "\\(p\\)-component only",
       "\\(s\\)-component only",
       "Unpolarised light",
       "Circular light"
      ],
      "answer": 0,
      "why": "Each surface reflects \\(s\\) and passes all \\(p\\), filtering out \\(s\\)."
     },
     "figure": {
      "focus": [
       "refl",
       "trans",
       "thB"
      ],
      "keep": [
       "inc",
       "plate",
       "normal"
      ],
      "caption": "Every surface: reflect s, pass p"
     }
    }
